<div class="container mt-3 mb-4">
  <div class="km--card km--form-card km--form-compact km--filter-card">
    <%# Collapsed by default: only the active-filter summary shows until expanded %>
    <button type="button" class="km--filter-toggle collapsed" data-bs-toggle="collapse"
            data-bs-target="#request-filters" aria-expanded="false" aria-controls="request-filters">
      <span class="d-flex align-items-center gap-2">
        <i class="fa-solid fa-filter"></i>
        <span class="km--text-card-subtitle"><%= request_filter_summary %></span>
      </span>
      <i class="fa-solid fa-chevron-down km--filter-chevron"></i>
    </button>
    <div class="collapse" id="request-filters">
      <div class="pt-3">
        <%= form_with url: requests_path, method: :get, data: { controller: "form-submission", turbo_frame: "requests_list" }, class: "row g-3" do |f| %>
          <%# Top row: Search, Prefecture, No Offers %>
          <div class="row g-3 mt-0">
            <%# Search Bar %>
            <div class="col-md-6 col-lg-5">
              <%= f.label :query, t("navigation.search"), class: "km--text-card-category km--text-soft d-block mb-2" %>
              <%= f.text_field :query, value: params[:query], placeholder: t("navigation.search_items"), class: "km--form-control form-control" %>
            </div>
            <%# Prefecture Dropdown %>
            <div class="col-md-6 col-lg-4">
              <%= f.label :prefecture, t("navigation.location"), class: "km--text-card-category km--text-soft d-block mb-2" %>
              <%= f.select :prefecture,
                Request::REGIONS_AND_PREFECTURES.transform_keys { |region| t("regions.#{region}") }
                .transform_values { |prefectures| prefectures.map { |p| [t("prefectures.#{p}"), p] } },
                { include_blank: t("prefectures.all"), selected: params[:prefecture] },
                class: "km--form-control form-select" %>
            </div>
            <%# No Offers Checkbox — boxed like the inputs beside it so the row lines up %>
            <div class="col-md-12 col-lg-3">
              <span class="km--text-card-category km--label-space-only d-none d-lg-block mb-2" aria-hidden="true">&nbsp;</span>
              <div class="km--form-control form-control d-flex align-items-center">
                <div class="d-flex align-items-center gap-2">
                  <%= f.check_box :no_offers, { checked: params[:no_offers] == "1", class: "form-check-input m-0", data: { action: "change->form-submission#search" } }, "1", "0" %>
                  <%= f.label :no_offers, t("navigation.no_offers_yet"), class: "form-check-label km--text-label text-nowrap mb-0" %>
                </div>
              </div>
            </div>
          </div>
          <%# TO DO: Add "Accepts shipping" / "Accepts drop-off" filters once these are real columns on charities %>
          <%# Row 2: Categories %>
          <div class="row g-3 mt-0">
            <div class="col-12 mt-0">
              <label class="km--text-card-category km--text-soft d-block mb-2"><%= t("navigation.category") %></label>
              <div class="border rounded p-3 bg-white" data-form-submission-target="categoryGroup">
                <div class="row row-cols-2 row-cols-md-3 row-cols-lg-5 g-2">
                  <div class="col">
                    <div class="form-check">
                      <%= check_box_tag "category[]", "", params[:category].blank?, id: "category_all", class: "form-check-input", data: { action: "change->form-submission#allCategoryChanged" } %>
                      <%= label_tag "category_all", t("categories.all"), class: "form-check-label" %>
                    </div>
                  </div>
                  <%= f.collection_check_boxes :category, @categories.map { |c| [c, t("categories.#{c}")] }, :first, :last, include_hidden: false do |b| %>
                    <div class="col">
                      <div class="form-check">
                        <%= b.check_box class: "form-check-input", checked: params[:category]&.include?(b.value), data: { action: "change->form-submission#categoryChanged" } %>
                        <%= b.label class: "form-check-label" %>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
          <%# Row 3: Submit & Reset %>
          <div class="col-md-12 d-flex justify-content-end mt-2">
            <%= link_to t("navigation.reset"), requests_path, class: "km--btn km--btn-outline me-3", data: { turbo_frame: "requests_list" } %>
            <%= f.submit t("navigation.filter"), class: "km--btn km--btn-primary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
<div class="container-fluid px-4 px-xl-5 mb-5">
  <% if @requests.empty? %>
    <div class="text-center mt-5">
      <h4 class="km--text-soft"><%= t("navigation.no_requests") %></h4>
    </div>
  <% else %>
    <div class="km--card-grid km--card-grid-wide">
      <% @requests.each do |request| %>
        <%= link_to request_path(request), class: "text-decoration-none km--text-dark", data: { turbo_frame: "_top" } do %>
          <div class="km--card km--card-hover h-100">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <div>
                <span class="km--text-card-title"><%= request.title %></span>
                <p class="km--text-card-subtitle mb-0">
                  <i class="fa-solid fa-location-dot me-1"></i><%= charity_location(request.charity) %>
                </p>
              </div>
              <div class="text-center flex-shrink-0 ms-2 km--qty-col">
                <div class="km--text-card-title mb-0"><%= quantity_label(request.quantity_remaining) %></div>
                <span class="badge rounded-pill pill-<%= request.urgency %> km--text-pill km--text-light">
                  <%= t("urgencies.#{request.urgency}") %>
                </span>
                <div class="progress km--progress km--progress-sm mt-2" role="progressbar"
                     aria-valuenow="<%= request.quantity_fulfilled %>" aria-valuemin="0" aria-valuemax="<%= request.quantity_needed %>">
                  <div class="progress-bar km--progress-bar" style="width: <%= request.fulfillment_percent %>%;"></div>
                </div>
              </div>
            </div>
            <div class="mb-2">
              <% request.category.each do |cat| %>
                <span class="km--text-card-category km--text-soft me-2"><%= t("categories.#{cat}") %></span>
              <% end %>
            </div>
            <div class="km--text-card-content mb-1">
              <i class="fa-solid fa-box-open me-1"></i>
              <% request.acceptable_conditions.each do |condition| %>
                <span class="badge text-bg-info me-1"><%= t("conditions.#{condition}") %></span>
              <% end %>
            </div>
            <%= render "requests/handoff_icons", charity: request.charity %>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
<% if policy(Request).new? %>
  <%= link_to new_request_path, class: "btn-kifor-fab", data: { controller: "fab" } do %>
    <i class="fa-solid fa-plus"></i>
  <% end %>
<% end %>
