<% read_only = local_assigns.fetch(:read_only, false) %>
<h2 class="km--text-card-title mb-3"><%= t("offers.offers") %></h2>
<% if @offers.empty? %>
  <p class="km--text-soft"><%= t("offers.no_offers") %></p>
<% else %>
  <% submitted_offers = @offers.select { |offer| offer.status == "submitted" } %>
  <% shipped_offers = @offers.select { |offer| offer.status == "shipped" } %>
  <% awaiting_feedback_offers = @offers.select { |offer| offer.status == "received" } %>

  <ul class="nav nav-tabs km--nav-tabs km--nav-tabs-page mb-3" id="charity-offers-tabs" role="tablist">
    <li class="nav-item" role="presentation">
      <button class="nav-link km--nav-link active" data-bs-toggle="pill" data-bs-target="#charity-offers-all" type="button">
        <%= t("offers.tabs.all") %>
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link km--nav-link" data-bs-toggle="pill" data-bs-target="#charity-offers-submitted" type="button">
        <%= t("offers.tabs.submitted") %>
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link km--nav-link" data-bs-toggle="pill" data-bs-target="#charity-offers-shipped" type="button">
        <%= t("offers.tabs.shipped") %>
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link km--nav-link" data-bs-toggle="pill" data-bs-target="#charity-offers-feedback" type="button">
        <%= t("offers.tabs.awaiting_feedback") %>
      </button>
    </li>
  </ul>
  <div class="tab-content">
    <div class="tab-pane fade show active" id="charity-offers-all">
      <% @offers.each do |offer| %>
        <%= render "requests/charity_offer_card", offer: offer, parent_request: @request, read_only: read_only %>
      <% end %>
    </div>
    <div class="tab-pane fade" id="charity-offers-submitted">
      <% if submitted_offers.empty? %>
        <p class="km--text-soft"><%= t("offers.no_offers") %></p>
      <% else %>
        <% submitted_offers.each do |offer| %>
          <%= render "requests/charity_offer_card", offer: offer, parent_request: @request, read_only: read_only %>
        <% end %>
      <% end %>
    </div>
    <div class="tab-pane fade" id="charity-offers-shipped">
      <% if shipped_offers.empty? %>
        <p class="km--text-soft"><%= t("offers.no_offers") %></p>
      <% else %>
        <% shipped_offers.each do |offer| %>
          <%= render "requests/charity_offer_card", offer: offer, parent_request: @request, read_only: read_only %>
        <% end %>
      <% end %>
    </div>
    <div class="tab-pane fade" id="charity-offers-feedback">
      <% if awaiting_feedback_offers.empty? %>
        <p class="km--text-soft"><%= t("offers.no_offers") %></p>
      <% else %>
        <% awaiting_feedback_offers.each do |offer| %>
          <%= render "requests/charity_offer_card", offer: offer, parent_request: @request, read_only: read_only %>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
