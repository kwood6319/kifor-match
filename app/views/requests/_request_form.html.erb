<%= simple_form_for request do |f| %>
  <div class="row">
    <div class="col-md-4">
      <%= f.input :title, label: t("requests.title"), placeholder: t("requests.title_placeholder") %>
    </div>
    <div class="col-md-4">
      <%= f.input :quantity_needed, label: t("requests.quantity_needed"), placeholder: "1, 2, 3..." %>
    </div>
  </div>
  <div class="row">
    <div class="col-md-4">
      <%= f.input :urgency,
        label: t("requests.urgency"),
        collection: Request::URGENCIES.map { |u| [t("urgencies.#{u}"), u] },
        prompt: t("urgencies.select_urgency") %>
    </div>
    <div class="col-md-4">
      <%= f.input :condition,
        label: t("requests.condition"),
        collection: Request::CONDITIONS.map { |c| [t("conditions.#{c}"), c] },
        prompt: t("conditions.select"),
        hint: t("requests.condition_message") %>
    </div>
    <div class="mb-4">
      <label class="form-label fw-bold"><%= t("navigation.category") %></label>
      <div class="border rounded p-3" data-controller="category-subcategory">
        <div class="row row-cols-2 row-cols-md-3 g-2 mb-3">
          <%= f.collection_check_boxes :category, CategoryList::CATEGORIES.keys.map { |c| [c, t("categories.#{c}")] }, :first, :last do |b| %>
            <div class="col">
              <div class="form-check">
                <%= b.check_box class: "form-check-input",
                data: {
                  action: "change->category-subcategory#toggle",
                  "category-subcategory-target": "categoryCheckbox",
                  category: b.value
                } %>
                <%= b.label class: "form-check-label" %>
              </div>
            </div>
          <% end %>
        </div>
        <% CategoryList::CATEGORIES.each do |key, data| %>
          <% next if data[:subcategories].blank? %>
          <div class="subcategory-group mb-3 <%= 'd-none' unless f.object.category.include?(key) %>"
         data-category-subcategory-target="subcategoryGroup"
         data-category="<%= key %>">
            <label class="form-label small text-muted mb-1"><%= CategoryList.label_for(key) %> — <%= t("navigation.subcategory") %></label>
            <div class="row row-cols-2 row-cols-md-4 g-2">
              <% data[:subcategories].each do |sub| %>
                <div class="col">
                  <div class="form-check">
                    <%= check_box_tag "request[subcategory][]", sub,
                    f.object.subcategory.include?(sub),
                    id: "subcategory_#{sub}",
                    class: "form-check-input",
                    multiple: true,
                    data: { "category-subcategory-target": "subcategoryCheckbox" } %>
                    <%= label_tag "subcategory_#{sub}", CategoryList.subcategory_label_for(key, sub), class: "form-check-label small" %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
        <button type="button" class="btn btn-sm btn-outline-secondary" data-action="click->category-subcategory#reset">
          <%= t("buttons.reset_categories") %>
        </button>
      </div>
    </div>
  </div>
  <div class="row">
    <div class="col-12">
      <%= f.input :description,
        label: t("requests.description"),
        placeholder: t("requests.description_message") %>
    </div>
  </div>
  <%= f.hidden_field :status, value: "active" %>
  <%= f.submit class: "btn btn-primary mt-3" %>
<% end %>
