<% read_only = local_assigns.fetch(:read_only, false) %>
<div class="km--card mb-3<%= ' km--card-rejected' if offer.status == 'rejected' %>">
  <%= link_to "", offer_path(offer), class: "stretched-link", aria: { label: t("offers.view_details") } %>
  <div class="row g-3">
    <div class="col-5">
      <% if offer.photos.attached? %>
        <div class="position-relative d-inline-block">
          <%= image_tag offer.photos.first, class: "img-fluid rounded" %>
          <% remaining = offer.photos.count - 1 %>
          <% if remaining > 0 %>
            <span class="badge bg-dark bg-opacity-75 position-absolute bottom-0 end-0 m-2 fs-6">
              +<%= remaining %>
            </span>
          <% end %>
        </div>
      <% else %>
        <div class="km--offer-image km--offer-image-placeholder">
          📷 <%= t("offers.no_image") %>
        </div>
      <% end %>
    </div>
    <div class="col-7 d-flex flex-column align-items-start gap-1">
      <strong class="km--text-card-title"><%= title_with_quantity(parent_request.title, offer.quantity_offered) %></strong>
      <p class="km--text-card-content mb-0">
        <%= donor_icon(offer.donor) %><%= offer.donor.display_name %>
      </p>
      <% if offer.donor.prefecture %>
        <p class="km--text-card-content mb-0">
          <i class="fa-solid fa-location-dot fa-fw me-1"></i><%= t("prefectures.#{offer.donor.prefecture}") %>
        </p>
      <% end %>
      <p class="km--text-card-content mb-0" title="<%= t("navigation.condition") %>">
        <i class="fa-solid fa-box-open fa-fw me-1"></i><span class="badge text-bg-info"><%= t("conditions.#{offer.condition}") %></span>
      </p>
      <% if offer.can_ship_by %>
        <p class="km--text-card-content mb-0" title="<%= t("offers.can_ship_by") %>">
          <i class="fa-solid fa-truck fa-fw me-1"></i><%= l(offer.can_ship_by, format: :short) %>
        </p>
      <% end %>
      <% if offer.message.present? %>
        <p class="km--text-card-content mb-0" title="<%= t("offers.message") %>">
          <i class="fa-solid fa-message fa-fw me-1"></i><%= offer.message %>
        </p>
      <% end %>
      <p class="km--text-card-category km--text-soft mt-2 mb-1"><%= t("offers.status") %></p>
      <% if read_only %>
        <div class="mb-1"><%= offer_status_badge(offer) %></div>
      <% end %>
      <% case offer.status
         when "submitted" %>
        <% if read_only %>
          <p class="km--text-card-content mb-0"><%= t("statuses.charity.submitted_message") %></p>
        <% else %>
          <p class="km--text-card-content mb-2"><%= offer.charity_alert_message %></p>
          <div class="d-flex justify-content-end gap-3 w-100">
            <% if policy(offer).reject? %>
              <button type="button"
                class="km--btn km--btn-danger"
                data-bs-toggle="modal"
                data-bs-target="#rejectOfferModal"
                data-reject-url="<%= reject_offer_path(offer) %>">
                <%= t("buttons.reject") %>
              </button>
            <% end %>
            <% if policy(offer).approve? %>
              <%= button_to t("buttons.approve"), approve_offer_path(offer), method: :patch, class: "km--btn km--btn-primary" %>
            <% end %>
          </div>
        <% end %>
      <% when "approved" %>
        <p class="km--text-card-content mb-0"><%= read_only ? t("statuses.charity.approved_message") : offer.charity_alert_message %></p>
      <% when "shipped" %>
        <% unless read_only %>
          <p class="km--text-card-content mb-1"><%= offer.charity_alert_message %></p>
        <% end %>
        <p class="km--text-card-content mb-0">
          <strong><%= t("statuses.donor.arriving") %>:</strong> <%= offer.estimated_arrival || "?" %>
        </p>
        <p class="km--text-card-content mb-0">
          <strong><%= t("statuses.donor.tracking_info") %>:</strong> <%= offer.tracking_number.presence || "?" %>
        </p>
        <% unless read_only %>
          <div class="d-flex justify-content-end w-100 mt-2">
            <%= button_to t("statuses.donor.received"), mark_received_offer_path(offer), method: :patch, class: "km--btn km--btn-danger" %>
          </div>
        <% end %>
      <% when "rejected" %>
        <p class="km--text-card-content mb-0"><%= read_only ? t("statuses.charity.rejected_message") : offer.charity_alert_message %></p>
      <% when "received" %>
        <p class="km--text-card-content mb-0"><%= read_only ? t("statuses.charity.received_message") : offer.charity_alert_message %></p>
        <%# TO DO: Once feedback is saved, show a "Feedback left" check and an Edit feedback link here (see FeedbacksController#create) %>
        <% unless read_only %>
          <div class="d-flex justify-content-end w-100 mt-2">
            <%= link_to t("buttons.give_feedback"),
                  new_request_feedback_path(parent_request, offer_id: offer.id),
                  class: "km--btn km--btn-primary" %>
          </div>
        <% end %>
      <% else %>
        <p class="km--text-card-content mb-0 text-capitalize"><%= t("statuses.charity.#{offer.status}_message", default: offer.status) %></p>
      <% end %>
    </div>
  </div>
</div>
