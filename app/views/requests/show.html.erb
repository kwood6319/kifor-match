<div class="container mt-3 mb-4">
  <div class="row align-items-stretch g-4">
    <%# Left column: request background + similar requests %>
    <div class="col-lg-5 d-flex flex-column gap-4">
      <%# Request background card %>
      <div class="km--card">
        <div class="row pt-2">
          <div class="col-8">
            <h2 class="km--text-card-title"><%= @request.title %></h2>
            <p class="km--text-card-subtitle mb-0">
              <i class="fa-solid fa-location-dot me-1"></i><%= charity_location(@request.charity) %>
            </p>
          </div>
          <div class="col-4 text-center">
            <h3 class="km--text-card-title mb-1"><%= quantity_label(@request.quantity_remaining) %></h3>
            <% if @request.archived? %>
              <div class="badge rounded-pill text-bg-secondary km--text-pill">
                <%= t("statuses.requests.archived") %>
              </div>
            <% else %>
              <div class="badge rounded-pill pill-<%= @request.urgency %> km--text-pill km--text-light">
                <%= t("urgencies.#{@request.urgency}") %>
              </div>
            <% end %>
          </div>
        </div>
        <div class="progress my-3 km--progress" style="height: 8px;">
          <div class="progress-bar km--progress-bar" role="progressbar"
               style="width: <%= @request.fulfillment_percent %>%;"
               aria-valuenow="<%= @request.quantity_fulfilled %>" aria-valuemin="0" aria-valuemax="<%= @request.quantity_needed %>">
          </div>
        </div>
        <div class="mb-3">
          <p class="km--text-card-category km--text-soft mb-2"><%= t("navigation.category") %></p>
          <p class="km--text-card-content mb-0">
            <%= @request.category.map { |cat| t("categories.#{cat}") }.join(", ") %>
          </p>
        </div>
        <div class="mb-3">
          <p class="km--text-card-category km--text-soft mb-2"><%= t("navigation.condition") %></p>
          <div class="d-flex flex-wrap gap-2">
            <% @request.acceptable_conditions.each do |cond| %>
              <span class="badge text-bg-info km--text-pill"><%= t("conditions.#{cond}") %></span>
            <% end %>
          </div>
        </div>
        <div class="mb-3">
          <p class="km--text-card-category km--text-soft mb-2"><%= t("navigation.description") %></p>
          <p class="km--text-card-content mb-0"><%= @request.description %></p>
        </div>
        <div class="mb-3">
          <p class="km--text-card-category km--text-soft mb-2"><%= t("shipping.shipping_and_drop_off") %></p>
          <% if @request.charity.accepts_shipping? %>
            <p class="km--text-card-content mb-1">
              <i class="fa-solid fa-truck me-1"></i><%= t("shipping.accepts_shipping") %>
            </p>
          <% end %>
          <div class="d-flex justify-content-between align-items-center">
            <p class="km--text-card-content mb-0<%= ' km--text-soft' unless @request.charity.accepts_drop_off? %>">
              <i class="fa-solid fa-box me-1"></i>
              <%= @request.charity.accepts_drop_off? ? t("shipping.accepts_drop_off") : t("shipping.no_drop_off") %>
            </p>
            <% if @request.charity.accepts_drop_off? %>
              <p class="km--text-card-content km--text-soft mb-0">
                <%# TO DO: Replace with the charity's real drop-off hours %>
                Mon - Fri 9AM - 5PM
              </p>
            <% end %>
          </div>
        </div>
        <div class="d-flex gap-3">
          <% if policy(@request).edit? %>
            <%= link_to t("buttons.edit_request"), edit_request_path(@request), class: "km--btn km--btn-outline" %>
          <% end %>
          <% if policy(@request).destroy? %>
            <button type="button"
              class="km--btn km--btn-danger"
              data-bs-toggle="modal"
              data-bs-target="#deleteModal"
              data-action-url="<%= request_path(@request) %>"
              data-action-method="delete"
              data-action-title="<%= t("modals.delete_request.title") %>" >
              <%= t("buttons.delete") %>
            </button>
          <% end %>
        </div>
        <div class="mt-3">
          <% if policy(@request).archive? %>
            <button type="button"
              class="km--btn km--btn-outline"
              data-bs-toggle="modal"
              data-bs-target="#deleteModal"
              data-action-url="<%= archive_request_path(@request) %>"
              data-action-method="patch"
              data-action-title="<%= t("modals.archive_request.title") %>"
              data-action-label="<%= t("buttons.archive") %>" >
              <%= t("buttons.archive_request") %>
            </button>
          <% end %>
        </div>
      </div>
      <%# Similar requests — donor-only, a charity or admin has nothing to donate %>
      <% unless current_user.charity? || current_user.admin? %>
        <h4 class="km--text-card-title mb-0"><%= t("navigation.similar_requests") %>:</h4>
        <% if @similar_requests.present? %>
          <% @similar_requests.each do |similar_request| %>
            <%= link_to request_path(similar_request), class: "text-decoration-none km--text-dark" do %>
              <div class="km--card">
                <div class="row">
                  <div class="col-8">
                    <p class="km--text-card-title mb-0"><%= similar_request.title %></p>
                    <p class="km--text-card-subtitle mb-2">
                      <i class="fa-solid fa-location-dot me-1"></i><%= charity_location(similar_request.charity) %>
                    </p>
                  </div>
                  <div class="col-4 text-center">
                    <p class="km--text-card-title mb-1"><%= quantity_label(similar_request.quantity_remaining) %></p>
                    <span class="badge rounded-pill pill-<%= similar_request.urgency %> km--text-pill km--text-light">
                      <%= t("urgencies.#{similar_request.urgency}") %>
                    </span>
                  </div>
                </div>
                <p class="km--text-card-category km--text-soft mb-2"><%= t("navigation.condition") %></p>
                <div class="d-flex flex-wrap gap-2">
                  <% similar_request.acceptable_conditions.each do |cond| %>
                    <span class="badge text-bg-info km--text-pill"><%= t("conditions.#{cond}") %></span>
                  <% end %>
                </div>
              </div>
            <% end %>
          <% end %>
        <% else %>
          <div class="km--card">
            <p class="km--text-card-content mb-0">
              <i class="fa-solid fa-hourglass-half me-1"></i><%= t("navigation.similar_requests_coming_soon") %>
            </p>
          </div>
        <% end %>
      <% end %>
    </div>
    <%# Right column: offer form / existing offer / charity view / admin view %>
    <div class="col-lg-6 mx-3">
      <% if current_user.admin? %>
        <%= render "currentcharityrequest", request: @request, read_only: true %>
      <% elsif current_user.charity? && current_user.charity == @request.charity %>
        <%= render "currentcharityrequest", request: @request %>
      <% elsif @editing_offer.present? && @editing_offer == @my_offer %>
        <%= render "offers/form", request: @request, offer: @my_offer %>
      <% elsif @my_offer.present? %>
        <%= render 'currentdonorexistingoffer', request: @request, offer: @my_offer %>
      <% elsif policy(Offer.new(request: @request)).new? %>
        <%= render 'offers/form', request: @request, offer: @offer %>
      <% end %>
    </div>
  </div>
</div>
<%= render "shared/reject_offer_modal" %>
<%# Delete modal %>
<div class="modal fade"
      id="deleteModal"
      tabindex="-1"
      aria-hidden="true"
      data-controller="action-modal">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" data-action-modal-target="title"></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <%= form_tag "#", method: :post, data: { action_modal_target: "form" } do %>
        <input type="hidden" name="_method" value="delete" data-action-modal-target="method">
        <div class="modal-footer">
          <button type="button" class="km--btn km--btn-outline" data-bs-dismiss="modal"><%= t("buttons.cancel") %></button>
          <%= submit_tag t("buttons.delete"), class: "km--btn km--btn-danger", data: { action_modal_target: "submit", default_label: t("buttons.delete")} %>
        </div>
      <% end %>
    </div>
  </div>
</div>
