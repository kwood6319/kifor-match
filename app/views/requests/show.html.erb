<div class="container mt-3 mb-4">
  <div class="row align-items-stretch g-4">
    <%# Left column: request background + similar requests %>
    <div class="col-lg-5 d-flex flex-column gap-4">
      <%= render "requests/request_summary", request: @request, show_actions: true %>
      <%# Similar requests — donor-only, a charity or admin has nothing to donate %>
      <% unless current_user.charity? || current_user.admin? %>
        <h4 class="km--text-card-title mb-0"><%= t("navigation.similar_requests") %>:</h4>
        <% if @similar_requests.present? %>
          <% @similar_requests.each do |similar_request| %>
            <%= link_to request_path(similar_request), class: "text-decoration-none km--text-dark" do %>
              <div class="km--card">
                <div class="row">
                  <div class="col-8">
                    <p class="km--text-card-title mb-0"><%= similar_request.title %></p>
                    <p class="km--text-card-subtitle mb-2">
                      <i class="fa-solid fa-location-dot me-1"></i><%= charity_location(similar_request.charity) %>
                    </p>
                  </div>
                  <div class="col-4 text-center">
                    <p class="km--text-card-title mb-1"><%= quantity_label(similar_request.quantity_remaining) %></p>
                    <span class="badge rounded-pill pill-<%= similar_request.urgency %> km--text-pill km--text-light">
                      <%= t("urgencies.#{similar_request.urgency}") %>
                    </span>
                  </div>
                </div>
                <p class="km--text-card-category km--text-soft mb-2"><%= t("navigation.condition") %></p>
                <div class="d-flex flex-wrap gap-2">
                  <% similar_request.acceptable_conditions.each do |cond| %>
                    <span class="badge text-bg-info km--text-pill"><%= t("conditions.#{cond}") %></span>
                  <% end %>
                </div>
              </div>
            <% end %>
          <% end %>
        <% else %>
          <div class="km--card">
            <p class="km--text-card-content mb-0">
              <i class="fa-solid fa-hourglass-half me-1"></i><%= t("navigation.similar_requests_coming_soon") %>
            </p>
          </div>
        <% end %>
      <% end %>
    </div>
    <%# Right column: offer form / existing offer / charity view / admin view %>
    <div class="col-lg-6 mx-3">
      <% if current_user.admin? %>
        <%= render "currentcharityrequest", request: @request, read_only: true %>
      <% elsif current_user.charity? && current_user.charity == @request.charity %>
        <%= render "currentcharityrequest", request: @request %>
      <% elsif @editing_offer.present? && @editing_offer == @my_offer && policy(@my_offer).edit? %>
        <%= render "offers/form", request: @request, offer: @my_offer %>
      <% elsif @my_offer.present? %>
        <%= render 'currentdonorexistingoffer', request: @request, offer: @my_offer %>
      <% elsif policy(Offer.new(request: @request)).new? %>
        <%= render 'offers/form', request: @request, offer: @offer %>
      <% end %>
    </div>
  </div>
</div>
<%= render "shared/reject_offer_modal" %>
<%# Delete modal %>
<div class="modal fade"
      id="deleteModal"
      tabindex="-1"
      aria-hidden="true"
      data-controller="action-modal">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title km--text-card-title" data-action-modal-target="title"></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <%= form_tag "#", method: :post, data: { action_modal_target: "form" } do %>
        <input type="hidden" name="_method" value="delete" data-action-modal-target="method">
        <div class="modal-footer">
          <button type="button" class="km--btn km--btn-outline" data-bs-dismiss="modal"><%= t("buttons.cancel") %></button>
          <%= submit_tag t("buttons.delete"), class: "km--btn km--btn-danger", data: { action_modal_target: "submit", default_label: t("buttons.delete")} %>
        </div>
      <% end %>
    </div>
  </div>
</div>
