<div class="km--card mb-3<%= ' km--card-rejected' if offer.status == 'rejected' %>">
  <h3 class="km--text-card-title text-center"><%= t("offers.existing_offer") %>:</h3>
  <div class="mb-3">
    <%= render "shared/photo_gallery", offer: offer %>
  </div>
  <div class="row">
    <h4 class="km--text-card-title"><%= title_with_quantity(request.title, offer.quantity_offered) %></h4>
  </div>
  <%# TO DO: Show the donor's region too ("Kanto - Tokyo") to match charity locations. %>
  <p class="km--text-card-content mb-0">
    <i class="fa-solid fa-location-dot"></i>
    <%= t("prefectures.#{offer.donor.prefecture}") if offer.donor.prefecture %>
  </p>
  <%# Section labels match the request card on the left %>
  <div class="mt-3 mb-3">
    <p class="km--text-card-category km--text-soft mb-2"><%= t("navigation.condition") %></p>
    <% if offer.condition.present? %>
      <span class="badge text-bg-info km--text-pill"><%= t("conditions.#{offer.condition}") %></span>
    <% else %>
      <p class="km--text-card-content mb-0"><%= t("conditions.no_condition") %></p>
    <% end %>
  </div>
  <%# Once shipped, the status section below shows the arrival date with the tracking number %>
  <% if !offer.shipped_or_later? && (ship_date = offer_ship_date(offer)) %>
    <div class="mb-3">
      <p class="km--text-card-category km--text-soft mb-2"><%= ship_date[:label] %></p>
      <p class="km--text-card-content mb-0"><%= ship_date_text(ship_date) %></p>
    </div>
  <% end %>
  <% if offer.message.present? %>
    <div class="mb-3">
      <p class="km--text-card-category km--text-soft mb-2"><%= t("offers.your_message") %></p>
      <p class="km--text-card-content mb-0"><%= offer.message %></p>
    </div>
  <% end %>
  <p class="km--text-card-category km--text-soft mb-2"><%= t("offers.status") %></p>
  <% if offer.status == "submitted" %>
    <p class="km--text-card-content"><%= t("statuses.donor.submitted_message") %></p>
  <% elsif offer.status == "approved" %>
    <%# "Please send the item…" is about shipping; drop-off has its own line below %>
    <% unless offer.drop_off? %>
      <p class="km--text-card-content mb-1"><%= t("statuses.donor.approved_message") %></p>
    <% end %>
    <p class="km--text-card-content"><%= offer.drop_off? ? t("drop_off.bring_to_address") : t("statuses.donor.charity_shipping_info") %></p>
    <%= render "shared/charity_shipping_address", offer: offer %>
    <%= render "requests/delivery_details_form", offer: offer, edit_link: true %>
  <% elsif offer.status == "rejected" %>
    <p class="km--text-card-content"><%= t("statuses.donor.rejected_message") %></p>
    <p class="km--text-card-category km--text-soft mt-3 mb-2"><%= t("activerecord.attributes.offer.rejection_reason") %></p>
    <p class="km--text-card-content"><%= offer.rejection_reason %></p>
  <% elsif offer.status == "shipped" %>
    <% if offer.drop_off? %>
      <p class="km--text-card-content"><%= t("drop_off.planned_message") %></p>
      <p class="km--text-card-content"><%= t("drop_off.planned_date") %>: <%= offer.estimated_arrival ? arrival_text(offer) : "?" %></p>
      <%= render "shared/charity_shipping_address", offer: offer %>
    <% else %>
      <p class="km--text-card-content"><%= t("statuses.donor.shipped_message") %>:</p>
      <p class="km--text-card-content"><%= t("statuses.donor.arriving") %>: <%= offer.estimated_arrival ? arrival_text(offer) : "?" %></p>
      <p class="km--text-card-content"><%= t("statuses.donor.tracking_info") %>: <%= offer.tracking_number.presence || "?" %></p>
      <%# Still useful once sent (e.g. checking what was written on the label) %>
      <%= render "shared/charity_shipping_address", offer: offer, hint: false %>
    <% end %>
    <%# Plans change: reopen the same form to update the date (and courier details when shipping) %>
    <% change_id = "change-delivery-#{offer.id}" %>
    <div class="d-flex justify-content-end">
      <button type="button" class="km--btn km--btn-outline" data-bs-toggle="collapse" data-bs-target="#<%= change_id %>"
              aria-expanded="false" aria-controls="<%= change_id %>">
        <%= offer.drop_off? ? t("drop_off.change_date") : t("statuses.donor.update_shipping") %>
      </button>
    </div>
    <div class="collapse" id="<%= change_id %>">
      <%= render "requests/delivery_details_form", offer: offer, cancel_target: change_id %>
    </div>
  <%# Completed only differs by the charity's internal feedback, which donors never see %>
  <% elsif offer.status.in?(%w[received completed]) %>
    <p class="km--text-card-content"><%= t("statuses.donor.received_message") %></p>
  <% end %>
  <% can_edit = offer.status.to_s == "submitted" %>
  <% can_delete = offer.status.to_s == "submitted" %>
  <% if can_edit || can_delete %>
    <div class="d-flex justify-content-end gap-3 mt-3">
      <% if can_delete %>
        <button
          type="button"
          class="km--btn km--btn-danger"
          data-bs-toggle="modal"
          data-bs-target="#deleteModal"
          data-action-url="<%= offer_path(offer) %>"
          data-action-title="<%= t("modals.delete_offer.title") %>" >
          <%= t("buttons.delete") %>
        </button>
      <% end %>
      <% if can_edit %>
        <%= link_to t("buttons.edit"),
          request_path(request, edit_offer: offer.id),
          class: "km--btn km--btn-primary" %>
      <% end %>
    </div>
  <% end %>
</div>
