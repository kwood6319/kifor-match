<h3 class="km--text-card-title"><%= t("offers.existing_offer") %>:</h3>
<div class="km--card mb-3<%= ' km--card-rejected' if offer.status == 'rejected' %>">
  <div class="mb-3">
    <%= render "shared/photo_gallery", offer: offer %>
  </div>
  <div class="row">
    <h4 class="km--text-card-title"><%= offer.quantity_offered %> <%= request.title %></h4>
  </div>
  <p class="km--text-card-content mb-0">
    <i class="fa-solid fa-location-dot"></i>
    <%= t("prefectures.#{offer.donor.prefecture}") if offer.donor.prefecture %>
  </p>
  <p class="km--text-card-content mb-0">
    <strong><%= t("navigation.condition") %>:</strong>
    <%= offer.condition.present? ? t("conditions.#{offer.condition}") : t("conditions.no_condition") %>
  </p>
  <% if offer.can_ship_by %>
    <p class="km--text-card-content mb-0">
      <strong><%= t("offers.can_ship_by") %>:</strong> <%= offer.can_ship_by.strftime("%b %e") %>
    </p>
  <% end %>
  <% if offer.message != "" %>
    <p class="km--text-card-content mb-0">
      <strong><%= t("offers.message") %>:</strong> <%= offer.message %>
    </p>
  <% end %>
  <h5 class="km--text-card-title mt-2"><%= t("offers.status") %>:</h5>
  <% if offer.status == "submitted" %>
    <p class="km--text-card-content"><%= t("statuses.donor.submitted_message") %></p>
  <% elsif offer.status == "approved" %>
    <p class="km--text-card-content mb-1"><%= t("statuses.donor.approved_message") %></p>
    <p class="km--text-card-content"><%= t("statuses.donor.charity_shipping_info") %></p>
    <p class="km--text-card-content my-2 mx-5"><%= offer.request.charity.shipping_address %></p>
    <%= simple_form_for offer,
      url: mark_as_shipped_offer_path(offer),
      method: :patch do |f| %>
      <div class="row mt-2">
        <div class="col-md-6">
          <%= f.input :estimated_arrival, label: t("statuses.donor.arriving"), as: :date, html5: true,
            input_html: { class: "km--form-control form-control" }, label_html: { class: "km--text-label" } %>
        </div>
        <div class="col-md-6">
          <%= f.input :tracking_number, label: t("statuses.donor.tracking_info"), placeholder: t("statuses.donor.tracking_prompt"),
            input_html: { class: "km--form-control form-control" }, label_html: { class: "km--text-label" } %>
        </div>
      </div>
      <%= f.submit t("buttons.save"), class: "km--btn km--btn-danger" %>
    <% end %>
  <% elsif offer.status == "rejected" %>
    <p class="km--text-card-content"><%= t("statuses.donor.rejected_message") %></p>
    <h5 class="km--text-card-title mt-2"><%= t("activerecord.attributes.offer.rejection_reason") %>:</h5>
    <p class="km--text-card-content"><%= offer.rejection_reason %></p>
  <% elsif offer.status == "shipped" %>
    <p class="km--text-card-content"><%= t("statuses.donor.shipped_message") %>:</p>
    <p class="km--text-card-content"><%= t("statuses.donor.arriving") %>: <%= offer.estimated_arrival ? offer.estimated_arrival : "?" %></p>
    <p class="km--text-card-content"><%= t("statuses.donor.tracking_info") %>: <%= offer.tracking_number != "" ? offer.tracking_number : "?" %></p>
  <% elsif offer.status == "received" %>
    <p class="km--text-card-content"><%= t("statuses.donor.received_message") %></p>
  <% end %>
</div>
