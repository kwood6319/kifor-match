<div class="km--card mb-3<%= ' km--card-rejected' if offer.status == 'rejected' %>">
  <h3 class="km--text-card-title text-center"><%= t("offers.existing_offer") %>:</h3>
  <div class="mb-3">
    <%= render "shared/photo_gallery", offer: offer %>
  </div>
  <div class="row">
    <h4 class="km--text-card-title"><%= title_with_quantity(request.title, offer.quantity_offered) %></h4>
  </div>
  <%# TO DO: Show the donor's region too ("Kanto - Tokyo") to match charity locations. %>
  <p class="km--text-card-content mb-0">
    <i class="fa-solid fa-location-dot"></i>
    <%= t("prefectures.#{offer.donor.prefecture}") if offer.donor.prefecture %>
  </p>
  <%# Section labels match the request card on the left %>
  <div class="mt-3 mb-3">
    <p class="km--text-card-category km--text-soft mb-2"><%= t("navigation.condition") %></p>
    <% if offer.condition.present? %>
      <span class="badge text-bg-info km--text-pill"><%= t("conditions.#{offer.condition}") %></span>
    <% else %>
      <p class="km--text-card-content mb-0"><%= t("conditions.no_condition") %></p>
    <% end %>
  </div>
  <% if (ship_date = offer_ship_date(offer)) %>
    <div class="mb-3">
      <p class="km--text-card-category km--text-soft mb-2"><%= ship_date[:label] %></p>
      <p class="km--text-card-content mb-0"><%= l(ship_date[:date], format: :short) %></p>
    </div>
  <% end %>
  <% if offer.message.present? %>
    <div class="mb-3">
      <p class="km--text-card-category km--text-soft mb-2"><%= t("offers.your_message") %></p>
      <p class="km--text-card-content mb-0"><%= offer.message %></p>
    </div>
  <% end %>
  <p class="km--text-card-category km--text-soft mb-2"><%= t("offers.status") %></p>
  <% if offer.status == "submitted" %>
    <p class="km--text-card-content"><%= t("statuses.donor.submitted_message") %></p>
  <% elsif offer.status == "approved" %>
    <p class="km--text-card-content mb-1"><%= t("statuses.donor.approved_message") %></p>
    <p class="km--text-card-content"><%= t("statuses.donor.charity_shipping_info") %></p>
    <p class="km--text-card-content my-2 mx-5"><%= offer.request.charity.shipping_address %></p>
    <%= simple_form_for offer,
      url: mark_as_shipped_offer_path(offer),
      method: :patch do |f| %>
      <div class="row mt-2">
        <div class="col-md-6">
          <%= f.input :estimated_arrival, label: t("statuses.donor.arriving"), as: :date, html5: true,
            input_html: { class: "km--form-control form-control" }, label_html: { class: "km--text-label" } %>
        </div>
        <div class="col-md-6">
          <%= f.input :tracking_number, label: t("statuses.donor.tracking_info"), placeholder: t("statuses.donor.tracking_prompt"),
            input_html: { class: "km--form-control form-control" }, label_html: { class: "km--text-label" } %>
        </div>
      </div>
      <div class="d-flex justify-content-end">
        <%= f.submit t("buttons.save"), class: "km--btn km--btn-primary" %>
      </div>
    <% end %>
  <% elsif offer.status == "rejected" %>
    <p class="km--text-card-content"><%= t("statuses.donor.rejected_message") %></p>
    <p class="km--text-card-category km--text-soft mt-3 mb-2"><%= t("activerecord.attributes.offer.rejection_reason") %></p>
    <p class="km--text-card-content"><%= offer.rejection_reason %></p>
  <% elsif offer.status == "shipped" %>
    <p class="km--text-card-content"><%= t("statuses.donor.shipped_message") %>:</p>
    <p class="km--text-card-content"><%= t("statuses.donor.arriving") %>: <%= offer.estimated_arrival ? offer.estimated_arrival : "?" %></p>
    <p class="km--text-card-content"><%= t("statuses.donor.tracking_info") %>: <%= offer.tracking_number != "" ? offer.tracking_number : "?" %></p>
  <% elsif offer.status == "received" %>
    <p class="km--text-card-content"><%= t("statuses.donor.received_message") %></p>
  <% end %>
  <% can_edit = %w[submitted approved].include?(offer.status.to_s) %>
  <% can_delete = offer.status.to_s == "submitted" %>
  <% if can_edit || can_delete %>
    <div class="d-flex justify-content-end gap-3 mt-3">
      <% if can_delete %>
        <button
          type="button"
          class="km--btn km--btn-danger"
          data-bs-toggle="modal"
          data-bs-target="#deleteModal"
          data-action-url="<%= offer_path(offer) %>"
          data-action-title="<%= t("modals.delete_offer.title") %>" >
          <%= t("buttons.delete") %>
        </button>
      <% end %>
      <% if can_edit %>
        <%= link_to t("buttons.edit"),
          request_path(request, edit_offer: offer.id),
          class: "km--btn km--btn-primary" %>
      <% end %>
    </div>
  <% end %>
</div>
