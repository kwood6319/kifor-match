<div class="contact_form form-card">
  <%= form_with url: "https://splitforms.com/api/submit",
                data: {
                  controller: "contact",
                  action: "submit->contact#send",
                  contact_redirect_url_value: root_path,
                  contact_success_message_value: t("contact.success"),
                  contact_error_message_value: t("contact.error"),
                  contact_network_error_message_value: t("contact.network_error")
                },
                method: :post, id: "my-contact-form" do |form| %>
    <%= form.hidden_field :access_key, value: ENV["SPLIT_FORMS_ACCESS_KEY"] %>
    <%= form.label :email, t("contact.email") %>
    <%= form.email_field :email, class: "form-control", placeholder: t("contact.placeholder_email"), required: true %>
    <%= form.label :name, t("contact.name") %>
    <%= form.text_field :name, class: "form-control", placeholder: t("contact.placeholder_name"), required: true %>
    <%= form.label :message, t("contact.message") %>
    <%= form.text_area :message, class: "form-control", rows: 5, placeholder: t("contact.placeholder_message"), required: true %>
    <%= form.submit t("contact.send") %>
  <% end %>
</div>
