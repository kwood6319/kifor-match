<%# Highlighted address box: pin heading, optional hint, the address rows, then anything passed in the block.
    Used for the donor's delivery address (via charity_shipping_address) and the admin charity page.
    Locals: address, title (optional: leave out when a heading sits above the box), hint (optional).
    Render with `layout:` to add content below the address. %>
<div class="km--address-box <%= local_assigns[:title] ? "my-3" : "mb-3" %>">
  <% if local_assigns[:title] %>
    <p class="km--text-card-category km--text-soft mb-2">
      <i class="fa-solid fa-location-dot me-1"></i><%= title %>
    </p>
  <% end %>
  <% if local_assigns[:hint].present? %>
    <p class="km--text-card-content km--text-soft mb-2"><%= hint %></p>
  <% end %>
  <%= render "shared/address", address: address %>
  <%= yield %>
</div>
