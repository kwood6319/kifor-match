<div class="container mt-3 mb-4">
  <div class="row align-items-stretch g-4">
    <%# Left column: charity details + stats %>
    <div class="col-lg-5">
      <%# Sticky so the details stay in view beside a long request list %>
      <div class="d-flex flex-column gap-4 km--sticky-column">
      <%# Charity details card %>
      <div class="km--card">
        <div class="row pt-2">
          <div class="col-8">
            <h2 class="km--text-card-title"><%= charity_icon %><%= @charity.org_name %></h2>
            <p class="km--text-card-subtitle mb-0">
              <i class="fa-solid fa-location-dot me-1"></i><%= location_label(@charity) %>
            </p>
          </div>
          <div class="col-4 text-center">
            <% if @charity.approved? %>
              <i class="fa-solid fa-circle-check text-success fa-lg"></i>
            <% else %>
              <span class="badge rounded-pill pill-urgent km--text-pill km--text-light text-nowrap">
                <%= t("statuses.charities.unapproved") %>
              </span>
            <% end %>
          </div>
        </div>
        <div class="mb-3 mt-3">
          <p class="km--text-card-content mb-0">
            <i class="fa-solid fa-envelope me-1"></i> <%= @charity.user.email %>
          </p>
        </div>
        <% if @charity.description.present? %>
          <div class="mb-3">
            <p class="km--text-card-category km--text-soft mb-2"><%= t("navigation.description") %></p>
            <p class="km--text-card-content mb-0"><%= @charity.description %></p>
          </div>
        <% end %>
        <% if @charity.shipping_address.present? %>
          <div class="mb-3">
            <p class="km--text-card-category km--text-soft mb-2"><%= t("shipping.address") %></p>
            <p class="km--text-card-content mb-0"><%= @charity.shipping_address %></p>
          </div>
        <% end %>
        <div class="d-flex justify-content-end gap-3">
          <%# TO DO: Add a Flag button once flagging exists %>
          <%= button_to t("buttons.delete"), charity_path(@charity), method: :delete,
                class: "km--btn km--btn-danger",
                data: { turbo_confirm: t("messages.delete_charity_confirm") } %>
          <% unless @charity.approved? %>
            <%= button_to t("buttons.approve"), approve_charity_path(@charity), method: :patch,
                  class: "km--btn km--btn-primary",
                  data: { turbo_confirm: t("messages.approve_charity_confirm") } %>
          <% end %>
        </div>
      </div>
      <%# Charity stats card %>
      <div class="km--card">
        <h4 class="km--text-card-title mb-3"><%= t("charities.stats") %></h4>
        <div class="d-flex justify-content-between mb-2">
          <span class="km--text-card-category km--text-soft"><%= t("charities.created_at") %></span>
          <span class="km--text-card-content"><%= @charity.created_at.strftime("%b %-d, %Y") %></span>
        </div>
        <div class="d-flex justify-content-between mb-2">
          <span class="km--text-card-category km--text-soft"><%= t("charities.approved_at") %></span>
          <span class="km--text-card-content">
            <%# No dedicated approved_at column, so updated_at is our best proxy for when approval happened. %>
            <%= @charity.approved? ? @charity.updated_at.strftime("%b %-d, %Y") : t("charities.not_approved") %>
          </span>
        </div>
        <div class="d-flex justify-content-between mb-2">
          <span class="km--text-card-category km--text-soft"><%= t("charities.total_requests") %></span>
          <span class="km--text-card-content"><%= @total_requests_count %></span>
        </div>
        <div class="d-flex justify-content-between mb-0">
          <span class="km--text-card-category km--text-soft"><%= t("charities.completed_requests") %></span>
          <span class="km--text-card-content"><%= @completed_requests_count %></span>
        </div>
      </div>
      </div>
    </div>
    <%# Right column: charity's requests, current and archived %>
    <div class="col-lg-6 mx-3">
      <%# TO DO: Add a filter for current requests %>
      <ul class="nav nav-tabs km--nav-tabs km--nav-tabs-page mb-3" role="tablist">
        <li class="nav-item" role="presentation">
          <button class="nav-link km--nav-link active" data-bs-toggle="pill" data-bs-target="#charity-requests-current" type="button">
            <i class="fa-solid fa-box-open"></i><%= t("charities.current_requests") %>
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link km--nav-link" data-bs-toggle="pill" data-bs-target="#charity-requests-history" type="button">
            <i class="fa-solid fa-clock-rotate-left"></i><%= t("navigation.history") %>
          </button>
        </li>
      </ul>
      <div class="tab-content km--tabs-stable">
        <div class="tab-pane fade show active" id="charity-requests-current">
          <% if @requests.present? %>
            <% @requests.each do |request| %>
              <%= render "charities/request_list_card", request: request %>
            <% end %>
          <% else %>
            <p class="km--text-soft mb-0"><%= t("charities.no_current_requests") %></p>
          <% end %>
        </div>
        <div class="tab-pane fade" id="charity-requests-history">
          <% if @archived_requests.present? %>
            <% @archived_requests.each do |request| %>
              <%= render "charities/request_list_card", request: request %>
            <% end %>
          <% else %>
            <p class="km--text-soft mb-0"><%= t("navigation.no_archived_requests") %></p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
