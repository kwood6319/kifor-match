<%# app/views/charities/dashboards/_request_card.html.erb %>
<%= link_to request_path(request), class: "text-decoration-none km--text-dark", data: { turbo_frame: "_top" } do %>
  <div class="km--card h-100">
    <div class="d-flex justify-content-between align-items-start mb-2">
      <span class="km--text-card-title"><%= request.title %></span>
      <div class="text-center flex-shrink-0 ms-2" style="width: 70px;">
        <div class="km--text-card-title mb-0">x<%= request.quantity_remaining %></div>
        <% if local_assigns[:archived] %>
          <span class="badge rounded-pill text-bg-secondary km--text-pill">
            <%= t("statuses.requests.archived") %>
          </span>
        <% else %>
          <span class="badge rounded-pill pill-<%= request.urgency %> km--text-pill km--text-light">
            <%= t("urgencies.#{request.urgency}") %>
          </span>
        <% end %>
        <div class="progress km--progress km--progress-sm mt-2" role="progressbar"
             aria-valuenow="<%= request.quantity_fulfilled %>" aria-valuemin="0" aria-valuemax="<%= request.quantity_needed %>">
          <div class="progress-bar km--progress-bar" style="width: <%= request.fulfillment_percent %>%;"></div>
        </div>
      </div>
    </div>
    <div class="mb-2">
      <% request.category.each do |cat| %>
        <span class="km--text-card-category km--text-soft me-2"><%= t("categories.#{cat}") %></span>
      <% end %>
    </div>
    <div class="km--text-card-content mb-1">
      <i class="fa-solid fa-box-open me-1"></i>
      <% request.acceptable_conditions.each do |condition| %>
        <span class="badge text-bg-info me-1"><%= t("conditions.#{condition}") %></span>
      <% end %>
    </div>
    <% unless local_assigns[:archived] %>
      <% pending_actions = request.offers.where(status: %w[submitted shipped]).count %>
      <% if pending_actions.positive? %>
        <div class="km--text-card-content">
          <i class="fa-solid fa-bell me-1"></i>
          <strong><%= pending_actions %></strong> <%= t("dashboard.pending_actions") %>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>
