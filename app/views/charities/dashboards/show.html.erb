<div class="container mt-3 mb-4">
  <h3><%= t("messages.welcome_back") %>, <%= current_user.email.gsub(/@.*$/, "").capitalize %><%="様" if I18n.locale == :ja %>!</h3>
</div>
<div class="container-fluid mt-4">
  <div class="row mb-4">
    <%# Left column — requests %>
    <div class="col-md-8">
      <h4 class="km--text-card-title mb-3"><%= t("dashboard.my_requests") %></h4>
      <div class="km--card-grid">
        <% @requests.each do |request| %>
          <%= render "charities/dashboards/request_card", request: request %>
        <% end %>
      </div>
    </div>
    <%# Right column — offer tracker, tabbed by status, styled after the donor dashboard %>
    <div class="col-md-4 d-flex">
      <div class="km--card w-100" style="max-height: 80vh; overflow-y: auto;">
        <ul class="nav nav-tabs km--nav-tabs mb-3" id="charity-tracker-tabs" role="tablist">
          <li class="nav-item" role="presentation">
            <button class="nav-link km--nav-link active" data-bs-toggle="pill" data-bs-target="#tracker-attention" type="button">
              <i class="fa-solid fa-triangle-exclamation"></i><%= t("dashboard.needs_your_attention") %>
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link km--nav-link" data-bs-toggle="pill" data-bs-target="#tracker-submitted" type="button">
              <i class="fa-solid fa-inbox"></i><%= t("dashboard.offers_submitted") %>
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link km--nav-link" data-bs-toggle="pill" data-bs-target="#tracker-shipped" type="button">
              <i class="fa-solid fa-truck"></i><%= t("dashboard.offers_on_their_way") %>
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link km--nav-link" data-bs-toggle="pill" data-bs-target="#tracker-feedback" type="button">
              <i class="fa-solid fa-comment-dots"></i><%= t("dashboard.offers_needing_feedback") %>
            </button>
          </li>
        </ul>
        <div class="tab-content">
          <div class="tab-pane fade show active" id="tracker-attention">
            <%= render "charities/dashboards/offer_tracker_list", offers: @actionable_offers %>
          </div>
          <div class="tab-pane fade" id="tracker-submitted">
            <%= render "charities/dashboards/offer_tracker_list", offers: @submitted_offers %>
          </div>
          <div class="tab-pane fade" id="tracker-shipped">
            <%= render "charities/dashboards/offer_tracker_list", offers: @shipped_offers %>
          </div>
          <div class="tab-pane fade" id="tracker-feedback">
            <%= render "charities/dashboards/offer_tracker_list", offers: @received_offers %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<% if policy(Request).new? %>
  <%= link_to new_request_path, class: "btn-kifor-fab", data: { controller: "fab" } do %>
    <i class="fa-solid fa-plus"></i>
  <% end %>
<% end %>
