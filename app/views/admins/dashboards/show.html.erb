<div class="container mt-3 mb-4">
  <h3 class="km--text-page-title mb-0"><%= t("messages.welcome_back") %>, <%= current_user.email.gsub(/@.*$/, "").capitalize %><%= "様" if I18n.locale == :ja %>!</h3>
</div>
<div class="container-fluid mt-4">
  <div class="row mb-4 g-3">
    <%# Left third — charity approvals %>
    <div class="col-md-4 d-flex">
      <div class="km--card km--scroll-card w-100">
        <h5 class="km--text-card-title mb-3">
          <i class="fa-solid fa-user-check"></i> <%= t("navigation.charities") %>
        </h5>
        <% if @unapproved_charities.any? %>
          <div class="km--card-list">
            <% @unapproved_charities.each do |charity| %>
              <%# Whole row links to the show page; the Approve button sits above the stretched link %>
              <div class="km--card-list-item d-flex justify-content-between align-items-center gap-2 position-relative">
                <div>
                  <%= link_to "", charity_path(charity), class: "stretched-link", aria: { label: charity.org_name } %>
                  <strong class="km--text-card-subtitle"><%= charity_icon %><%= charity.org_name %></strong>
                  <p class="km--text-card-content km--text-soft mb-0">
                    <i class="fa-solid fa-envelope me-1"></i><%= charity.user.email %>
                  </p>
                </div>
                <%= button_to t("buttons.approve"), approve_charity_path(charity), method: :patch, class: "km--btn km--btn-primary" %>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="km--text-soft mb-0"><%= t("dashboard.no_unapproved_charities") %></p>
        <% end %>
      </div>
    </div>
    <%# Middle third — donor approvals %>
    <div class="col-md-4 d-flex">
      <div class="km--card km--scroll-card w-100">
        <h5 class="km--text-card-title mb-3">
          <i class="fa-solid fa-user-check"></i> <%= t("navigation.donors") %>
        </h5>
        <% if @unapproved_donors.any? %>
          <div class="km--card-list">
            <% @unapproved_donors.each do |donor| %>
              <%# Whole row links to the show page; the Approve button sits above the stretched link %>
              <div class="km--card-list-item d-flex justify-content-between align-items-center gap-2 position-relative">
                <div>
                  <%= link_to "", donor_path(donor), class: "stretched-link", aria: { label: donor.display_name } %>
                  <strong class="km--text-card-subtitle"><%= donor_icon(donor) %><%= donor.display_name %></strong>
                  <p class="km--text-card-content km--text-soft mb-0">
                    <i class="fa-solid fa-envelope me-1"></i><%= donor.user.email %>
                  </p>
                </div>
                <%= button_to t("buttons.approve"), approve_donor_path(donor), method: :patch, class: "km--btn km--btn-primary" %>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="km--text-soft mb-0"><%= t("dashboard.no_unapproved_donors") %></p>
        <% end %>
      </div>
    </div>
    <%# Right third — flagged donations %>
    <div class="col-md-4 d-flex">
      <div class="km--card km--scroll-card w-100">
        <h5 class="km--text-card-title mb-3">
          <i class="fa-solid fa-flag"></i> <%= t("dashboard.flagged") %>
        </h5>
        <% if @flagged_offers.any? %>
          <div class="km--card-list">
            <% @flagged_offers.each do |offer| %>
              <%# Whole row links to the donor page; the buttons sit above the stretched link %>
              <div class="km--card-list-item d-flex justify-content-between align-items-center gap-2 position-relative">
                <div>
                  <%= link_to "", donor_path(offer.donor), class: "stretched-link", aria: { label: offer.donor.display_name } %>
                  <strong class="km--text-card-subtitle"><%= donor_icon(offer.donor) %><%= offer.donor.display_name %></strong>
                  <p class="km--text-card-content km--text-soft mb-0">
                    <i class="fa-solid fa-envelope me-1"></i><%= offer.donor.user.email %>
                  </p>
                  <p class="km--text-card-content mb-0">
                    <%= title_with_quantity(offer.request.title, offer.quantity_offered) %>
                    · <%= offer.request.charity.org_name %>
                  </p>
                  <% if offer.flag_reason.present? %>
                    <p class="km--text-card-content km--text-soft mb-0"><%= offer.flag_reason %></p>
                  <% end %>
                </div>
                <div class="d-flex flex-column gap-2 position-relative">
                  <%= button_to t("buttons.resolve"), resolve_offer_path(offer), method: :patch, class: "km--btn km--btn-primary" %>
                  <% if offer.donor.user.active? %>
                    <%= button_to t("buttons.deactivate"), deactivate_donor_path(offer.donor), method: :patch, class: "km--btn km--btn-danger" %>
                  <% else %>
                    <span class="badge text-bg-secondary km--text-pill"><%= t("buttons.deactivated") %></span>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="km--text-soft mb-0"><%= t("dashboard.no_flagged_offers") %></p>
        <% end %>
      </div>
    </div>
  </div>
</div>
