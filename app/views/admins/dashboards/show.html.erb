<div class="container mt-3 mb-4">
  <h3><%= t("messages.welcome_back") %>, <%= current_user.email.gsub(/@.*$/, "").capitalize %><%= "様" if I18n.locale == :ja %>!</h3>
</div>
<div class="container-fluid mt-4">
  <div class="row mb-4 g-3">
    <%# Left third — charity approvals %>
    <div class="col-md-4 d-flex">
      <div class="km--card w-100" style="max-height: 80vh; overflow-y: auto;">
        <h5 class="km--text-card-title mb-3">
          <i class="fa-solid fa-user-check"></i> <%= t("navigation.charities") %>
        </h5>
        <% if @unapproved_charities.any? %>
          <div class="km--card-list">
            <% @unapproved_charities.each do |charity| %>
              <div class="km--card-list-item d-flex justify-content-between align-items-center gap-2">
                <div>
                  <strong class="km--text-card-subtitle"><%= charity.org_name %></strong>
                  <p class="km--text-card-content km--text-soft mb-0"><%= charity.user.email %></p>
                </div>
                <%= button_to t("buttons.approve"), approve_charity_path(charity), method: :patch, class: "km--btn km--btn-primary" %>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="km--text-soft mb-0"><%= t("dashboard.no_unapproved_charities") %></p>
        <% end %>
      </div>
    </div>
    <%# Middle third — donor approvals %>
    <div class="col-md-4 d-flex">
      <div class="km--card w-100" style="max-height: 80vh; overflow-y: auto;">
        <h5 class="km--text-card-title mb-3">
          <i class="fa-solid fa-user-check"></i> <%= t("navigation.donors") %>
        </h5>
        <% if @unapproved_donors.any? %>
          <div class="km--card-list">
            <% @unapproved_donors.each do |donor| %>
              <div class="km--card-list-item d-flex justify-content-between align-items-center gap-2">
                <div>
                  <strong class="km--text-card-subtitle"><%= donor.display_name %></strong>
                  <p class="km--text-card-content km--text-soft mb-0"><%= donor.user.email %></p>
                </div>
                <%= button_to t("buttons.approve"), approve_donor_path(donor), method: :patch, class: "km--btn km--btn-primary" %>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="km--text-soft mb-0"><%= t("dashboard.no_unapproved_donors") %></p>
        <% end %>
      </div>
    </div>
    <%# Right third — flagged users (placeholder) %>
    <div class="col-md-4 d-flex">
      <div class="km--card w-100" style="max-height: 80vh; overflow-y: auto;">
        <h5 class="km--text-card-title mb-3">
          <i class="fa-solid fa-flag"></i> <%= t("dashboard.flagged") %>
        </h5>
        <p class="km--text-soft mb-0"><%= t("dashboard.flagged_placeholder") %></p>
      </div>
    </div>
  </div>
</div>
