<% offer ||= Offer.new %>
<div data-controller="postage-acknowledgment donation-rules" data-postage-acknowledgment-first-offer-value="<%= @first_offer %>">
  <div class="km--card km--form-compact">
    <h4 class="km--text-card-title text-center mb-1"><%= offer.persisted? ? t("offers.edit_offer") : t("offers.make_an_offer") %></h4>
    <p class="km--text-card-content km--text-soft text-center mb-4"><span class="km--required"></span> <%= t("offers.required_note") %></p>
    <% if offer.errors.any? %>
      <div class="alert alert-danger alert-dismissible fade show km--toast" role="alert">
        <strong><%= t("offers.errors_heading") %></strong>
        <ul class="list-unstyled mb-0 d-flex flex-column gap-1">
          <% offer.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="<%= t("buttons.close") %>"></button>
      </div>
    <% end %>
    <%= form_with(model: offer, url: offer.persisted? ? offer_path(offer) : request_offers_path(@request),
      data: offer.new_record? ? { "donation-rules-target": "form", action: "submit->donation-rules#intercept" } : {}) do |form| %>
      <div class="row g-3">
        <div class="col-md-6">
          <%= form.label :quantity_offered, t("offers.quantity_offered"), class: "km--text-card-category km--text-soft d-block mb-2 km--required" %>
          <%= form.number_field :quantity_offered, min: 1, value: offer.quantity_offered || 1, required: true, class: "km--form-control form-control" %>
        </div>
        <div class="col-md-6">
          <div class="km--text-card-category km--text-soft mb-2">
            <%= form.label :condition, t("navigation.condition"), class: "d-inline km--required" %>
            <%# TO DO: wire up modal with condition definitions/examples %>
            <button type="button" class="km--btn-link">(<%= t("offers.read_more") %>)</button>
          </div>
          <%= form.select :condition,
            Request::CONDITIONS.map { |condition| [t("conditions.#{condition}"), condition] },
            { prompt: t("conditions.select") },
            class: "km--form-control form-select" %>
        </div>
      </div>
      <div class="row g-3 mt-0">
        <%
          ship_by = offer.can_ship_by || Date.current
          month_year_options = (0..11).map do |offset|
            date = Date.current.next_month(offset)
            [l(date, format: :month_year), date.strftime("%Y-%m")]
          end
        %>
        <div class="col-md-6" data-controller="ship-date">
          <%= form.label :ship_by_day, t("offers.can_ship_by"), class: "km--text-card-category km--text-soft d-block mb-2 km--required" %>
          <div class="d-flex gap-2">
            <%= form.select :ship_by_day,
              (1..31).to_a,
              { selected: ship_by.day },
              class: "km--form-control form-select",
              data: { "ship-date-target": "day" } %>
            <%= form.select :ship_by_month_year,
              month_year_options,
              { selected: ship_by.strftime("%Y-%m") },
              class: "km--form-control form-select",
              data: { "ship-date-target": "monthYear", action: "change->ship-date#monthYearChanged" } %>
          </div>
        </div>
        <%# One way per donation, from the ways this need accepts: a choice if there are two, fixed if one.
            When editing, the offer's own method stays available even if the charity has since turned it
            off, so the donor only switches on purpose (an unchanged method still validates). %>
        <% methods = @request.delivery_methods %>
        <% kept_method = offer.delivery_method if offer.persisted? && methods.exclude?(offer.delivery_method) %>
        <% methods += [kept_method] if kept_method %>
        <div class="col-md-6">
          <p class="km--text-card-category km--text-soft mb-2"><%= t("shipping.delivery_method") %></p>
          <% if methods.many? %>
            <div class="d-flex gap-4 km--form-check-row">
              <% methods.each do |method| %>
                <div class="form-check">
                  <%= form.radio_button :delivery_method, method, class: "form-check-input",
                        data: { action: "change->postage-acknowledgment#methodChanged" } %>
                  <%= form.label "delivery_method_#{method}", class: "form-check-label" do %>
                    <%= t("shipping.#{method}") %>
                    <% if method == kept_method %>
                      <span class="km--text-soft">(<%= t("shipping.no_longer_offered") %>)</span>
                    <% end %>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% elsif methods.one? %>
            <%= form.hidden_field :delivery_method, value: methods.first %>
            <%# Same input-height row as the two-choice radios, so it lines up with the fields beside it %>
            <div class="d-flex km--form-check-row">
              <p class="km--text-card-content mb-0">
                <i class="fa-solid <%= methods.first == "drop_off" ? "fa-people-carry-box" : "fa-truck" %> me-1"></i><%= t("shipping.#{methods.first}") %>
                <% if methods.first == kept_method %>
                  <span class="km--text-soft">(<%= t("shipping.no_longer_offered") %>)</span>
                <% end %>
              </p>
            </div>
          <% else %>
            <%# e.g. the charity stopped shipping after posting a need without drop-off %>
            <div class="d-flex km--form-check-row">
              <p class="km--text-card-content km--text-soft mb-0"><%= t("shipping.none_available") %></p>
            </div>
          <% end %>
        </div>
      </div>
      <div class="mt-3">
        <%= form.label :message, t("offers.message"), class: "km--text-card-category km--text-soft d-block mb-2" %>
        <%= form.text_area :message, rows: 4, class: "km--form-control form-control", placeholder: t("offers.message_prompt") %>
      </div>
      <%# Photo upload: drag-and-drop dropzone + thumbnail previews with remove buttons %>
      <div class="mt-4" data-controller="photo-upload">
        <%= form.label :photos, t("offers.photos_of_item"), class: "km--text-card-category km--text-soft d-block mb-2 km--required" %>
        <%= form.file_field :photos, multiple: true, accept: "image/*",
          class: "d-none",
          data: { "photo-upload-target": "input", action: "change->photo-upload#inputChanged" } %>
        <div class="km--photo-upload-dropzone"
             data-photo-upload-target="dropzone"
             data-action="click->photo-upload#browse dragover->photo-upload#dragOver dragleave->photo-upload#dragLeave drop->photo-upload#drop">
          <i class="fa-solid fa-plus"></i>
        </div>
        <p class="km--text-card-content km--text-soft text-center mt-2 mb-2"><%= t("offers.photo_expl") %></p>
        <div class="km--photo-upload-preview-list">
          <%# Photos already saved on the offer. Removing one queues its id for removal on save. %>
          <% offer.photos.select(&:persisted?).each do |photo| %>
            <div class="km--photo-upload-thumb">
              <%= image_tag photo %>
              <button type="button" class="km--photo-upload-remove" aria-label="<%= t("offers.remove_photo") %>"
                data-action="click->photo-upload#removeExisting" data-photo-upload-id-param="<%= photo.id %>">
                <i class="fa-solid fa-xmark"></i>
              </button>
            </div>
          <% end %>
          <div class="km--display-contents" data-photo-upload-target="previewList"></div>
        </div>
        <div data-photo-upload-target="removedInputs"></div>
      </div>
      <%# Postage acknowledgment checkbox %>
      <div class="mt-4">
        <div class="form-check">
          <%# Already acknowledged when the offer was first sent %>
          <%= check_box_tag "postage_acknowledged", "1", offer.persisted?,
            id: "postage_acknowledged", class: "form-check-input",
            disabled: @first_offer,
            data: {
              "postage-acknowledgment-target": "checkbox",
              action: "change->postage-acknowledgment#toggle" } %>
          <%# Wording follows the delivery method: postage costs for shipping, the charity's time for drop-off.
              Changing method swaps it and unticks the box (postage-acknowledgment#methodChanged). %>
          <%= label_tag "postage_acknowledged", class: "form-check-label km--text-label km--required" do %>
            <span data-postage-acknowledgment-target="shippingText" <%= "hidden" if offer.drop_off? %>>
              <%= t("offers.postage_acknowledgment") %>
              <button type="button" class="km--btn-link"
                data-bs-toggle="modal" data-bs-target="#postageModal">(<%= t("offers.read_more") %>)</button>
            </span>
            <span data-postage-acknowledgment-target="dropOffText" <%= "hidden" unless offer.drop_off? %>>
              <%= t("drop_off.acknowledgment") %>
              <button type="button" class="km--btn-link"
                data-bs-toggle="modal" data-bs-target="#dropOffModal">(<%= t("offers.read_more") %>)</button>
            </span>
          <% end %>
        </div>
      </div>
      <%= form.hidden_field :request_id, value: @request.id %>
      <%= form.hidden_field :donor_id, value: @donor&.id %>
      <div class="d-flex justify-content-end mt-4">
        <%= form.submit offer.persisted? ? t("buttons.save") : t("offers.send_offer"),
          class: "km--btn km--btn-primary",
          disabled: !offer.persisted?,
          data: { "postage-acknowledgment-target": "submitButton" } %>
      </div>
    <% end %>
  </div>
  <%# Postage modal %>
  <div class="modal fade" id="postageModal" tabindex="-1"
       aria-labelledby="postageModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title km--text-card-title" id="postageModalLabel"><%= t("offers.postage_modal_title") %></h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t("buttons.close") %>"></button>
        </div>
        <div class="modal-body">
          <p><%= t("offers.postage_modal_body") %></p>
        </div>
        <div class="modal-footer">
          <button type="button" class="km--btn km--btn-primary" data-bs-dismiss="modal" data-action="click->postage-acknowledgment#acknowledge">
            <%= t("offers.postage_modal_confirm") %>
          </button>
        </div>
      </div>
    </div>
  </div>
  <%# Drop-off modal: the drop-off counterpart of the postage modal %>
  <div class="modal fade" id="dropOffModal" tabindex="-1"
       aria-labelledby="dropOffModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title km--text-card-title" id="dropOffModalLabel"><%= t("drop_off.modal_title") %></h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t("buttons.close") %>"></button>
        </div>
        <div class="modal-body">
          <p class="km--text-card-content mb-0"><%= t("drop_off.modal_body") %></p>
        </div>
        <div class="modal-footer">
          <button type="button" class="km--btn km--btn-primary" data-bs-dismiss="modal" data-action="click->postage-acknowledgment#acknowledge">
            <%= t("offers.postage_modal_confirm") %>
          </button>
        </div>
      </div>
    </div>
  </div>
  <%# Donation rules modal: shown on submit of a new offer, must be acknowledged before the form submits %>
  <% if offer.new_record? %>
    <div class="modal fade" id="donationRulesModal" tabindex="-1"
         data-bs-backdrop="static" data-bs-keyboard="false"
         data-donation-rules-target="modal"
         aria-labelledby="donationRulesModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
          <%# Styled like the app's other modals; it stays scrollable and outside clicks don't close it %>
          <div class="modal-header">
            <h5 class="modal-title km--text-card-title" id="donationRulesModalLabel"><%= t("offers.donation_rules_title") %></h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t("buttons.close") %>"></button>
          </div>
          <div class="modal-body">
            <%= render "offers/donation_rules", request: @request %>
            <div class="form-check mb-0">
              <input type="checkbox" id="donation_rules_acknowledged" class="form-check-input"
                     data-donation-rules-target="checkbox" data-action="change->donation-rules#toggle">
              <label for="donation_rules_acknowledged" class="form-check-label km--text-label">
                <%= t("offers.donation_rules_acknowledgment") %>
              </label>
            </div>
          </div>
          <%# Only Confirm here: the X in the header returns to the form unsent %>
          <div class="modal-footer">
            <button type="button" class="km--btn km--btn-primary" disabled
                    data-donation-rules-target="confirmButton" data-action="click->donation-rules#confirm">
              <%= t("offers.donation_rules_confirm") %>
            </button>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
