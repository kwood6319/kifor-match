<% content_for :title, t("offers.offer_details") %>
<div class="container mt-3 mb-4">
  <div class="row align-items-start g-4">
    <%# Left: same request card as requests/show %>
    <div class="col-lg-5">
      <%= render "requests/request_summary", request: @request, donor_offer: (@offer if current_user.donor?) %>
    </div>
    <%# Right: Offer detail %>
    <div class="col-lg-6 mx-3">
      <div class="km--card">
        <div class="mb-3">
          <%= render "shared/photo_gallery", offer: @offer %>
        </div>
        <h4 class="km--text-card-title mb-1"><%= title_with_quantity(@request.title, @offer.quantity_offered) %></h4>
        <p class="km--text-card-content mb-0">
          <%= donor_icon(@donor) %><%= @donor.display_name %>
        </p>
        <% if @donor.prefecture %>
          <p class="km--text-card-content mb-0">
            <i class="fa-solid fa-location-dot fa-fw me-1"></i><%= t("prefectures.#{@donor.prefecture}") %>
          </p>
        <% end %>
        <%# Section labels match the request card on the left %>
        <div class="mt-3 mb-3">
          <p class="km--text-card-category km--text-soft mb-2"><%= t("navigation.condition") %></p>
          <span class="badge text-bg-info km--text-pill"><%= t("conditions.#{@offer.condition}") %></span>
        </div>
        <div class="mb-3">
          <p class="km--text-card-category km--text-soft mb-2"><%= t("shipping.delivery_method") %></p>
          <p class="km--text-card-content mb-0">
            <i class="fa-solid <%= @offer.drop_off? ? "fa-people-carry-box" : "fa-truck" %> me-1"></i><%= t("shipping.#{@offer.delivery_method}") %>
          </p>
        </div>
        <% if (ship_date = offer_ship_date(@offer)) %>
          <div class="mb-3">
            <p class="km--text-card-category km--text-soft mb-2"><%= ship_date[:label] %></p>
            <p class="km--text-card-content mb-0"><%= ship_date_text(ship_date) %></p>
          </div>
        <% end %>
        <% if @offer.message.present? %>
          <div class="mb-3">
            <p class="km--text-card-category km--text-soft mb-2"><%= t("offers.message") %></p>
            <p class="km--text-card-content mb-0"><%= @offer.message %></p>
          </div>
        <% end %>
        <% if @offer.tracking_number.present? %>
          <div class="mb-3">
            <p class="km--text-card-category km--text-soft mb-2"><%= t("statuses.donor.tracking_info") %></p>
            <p class="km--text-card-content mb-0"><%= @offer.tracking_number %></p>
          </div>
        <% end %>
        <p class="km--text-card-category km--text-soft mb-2"><%= t("offers.status") %></p>
        <% if current_user.admin? %>
          <%= offer_status_badge(@offer) %>
        <% elsif @offer.status == "submitted" %>
          <% if policy(@offer).approve? || policy(@offer).reject? %>
            <p class="km--text-card-content mb-3"><%= @offer.charity_alert_message %></p>
            <div class="d-flex justify-content-end gap-3">
              <% if policy(@offer).reject? %>
                <button type="button"
                  class="km--btn km--btn-danger"
                  data-bs-toggle="modal"
                  data-bs-target="#rejectOfferModal"
                  data-reject-url="<%= reject_offer_path(@offer) %>">
                  <%= t("buttons.reject") %>
                </button>
              <% end %>
              <% if policy(@offer).approve? %>
                <%= button_to t("buttons.approve"), approve_offer_path(@offer), method: :patch, class: "km--btn km--btn-primary" %>
              <% end %>
            </div>
          <% else %>
            <p class="km--text-card-content mb-0"><%= t("statuses.charity.submitted_message") %></p>
          <% end %>
        <% elsif @offer.status == "approved" %>
          <p class="km--text-card-content mb-0"><%= current_user.charity? ? @offer.charity_alert_message : t("statuses.charity.approved_message") %></p>
          <% if current_user.donor? %>
            <%= render "shared/charity_shipping_address", offer: @offer %>
          <% end %>
        <% elsif @offer.status == "shipped" %>
          <p class="km--text-card-content mb-3"><%= current_user.charity? ? @offer.charity_alert_message : t("statuses.donor.shipped") %></p>
          <%# The donor keeps seeing where it's going once it's on its way %>
          <% if current_user.donor? %>
            <%= render "shared/charity_shipping_address", offer: @offer, hint: false %>
          <% end %>
          <% if policy(@offer).mark_received? %>
            <div class="d-flex justify-content-end">
              <%= button_to t("statuses.donor.received"), mark_received_offer_path(@offer), method: :patch, class: "km--btn km--btn-danger" %>
            </div>
          <% end %>
        <% elsif @offer.status == "rejected" %>
          <p class="km--text-card-content mb-0"><%= current_user.charity? ? @offer.charity_alert_message : t("statuses.charity.rejected_message") %></p>
        <% elsif @offer.status == "received" %>
          <% if current_user.charity? %>
            <%# The prompt and its button on one line %>
            <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap">
              <p class="km--text-card-content mb-0"><%= @offer.charity_alert_message %></p>
              <%# offer_id, not offer: passing the offer would set @offer.feedback to this unsaved draft %>
              <% if policy(Feedback.new(offer_id: @offer.id)).new? %>
                <%= link_to t("buttons.give_feedback"), new_offer_feedback_path(@offer), class: "km--btn km--btn-primary" %>
              <% end %>
            </div>
          <% else %>
            <p class="km--text-card-content mb-0"><%= t("statuses.donor.received_message") %></p>
          <% end %>
        <% elsif @offer.status == "completed" %>
          <p class="km--text-card-content mb-0"><%= t("statuses.donor.completed") %></p>
        <% end %>
        <%# Internal feedback: admins and the receiving charity only, never the donor %>
        <%# "Feedback given <date>" in the partial is the heading, so no separate title %>
        <% if @offer.feedback&.persisted? && policy(@offer.feedback).show? %>
          <div class="border-top mt-3 pt-3">
            <%= render "feedbacks/feedback", feedback: @offer.feedback %>
            <% if policy(@offer.feedback).edit? %>
              <div class="d-flex justify-content-end mt-3">
                <%= link_to t("buttons.edit_feedback"), edit_offer_feedback_path(@offer), class: "km--btn km--btn-outline" %>
              </div>
            <% end %>
          </div>
        <%# Admins only: the charity already sees "Give feedback" above %>
        <% elsif current_user.admin? && @offer.status.in?(%w[received completed]) %>
          <div class="border-top mt-3 pt-3">
            <span class="km--text-card-category km--text-soft">
              <i class="fa-solid fa-comment-dots me-1"></i><%= t("feedback.not_given") %>
            </span>
          </div>
        <% end %>
      </div>
    </div>
  </div>
  <%= render "shared/reject_offer_modal" %>
</div>
