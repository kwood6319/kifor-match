<% label = { class: "km--text-card-category km--text-soft" } %>
<div class="km--card km--form-card km--form-card-narrow km--form-compact">
  <h2 class="km--form-card-title"><%= t("navigation.log_in") %></h2>
  <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
    <div class="form-inputs">
      <%= f.input :email,
              required: false,
              autofocus: true,
              input_html: { autocomplete: "email", class: "km--form-control form-control" },
              label_html: label %>
      <%= f.input :password,
              required: false,
              input_html: { autocomplete: "current-password", class: "km--form-control form-control" },
              label_html: label %>
      <%= f.input :remember_me, as: :boolean if devise_mapping.rememberable? %>
    </div>
    <div class="form-actions d-flex justify-content-end">
      <%= f.button :submit, t("navigation.log_in"), class: "km--btn km--btn-primary" %>
    </div>
  <% end %>
  <div class="mt-3">
    <%= render "devise/shared/links" %>
  </div>
</div>
