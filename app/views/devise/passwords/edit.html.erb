<% label = { class: "km--text-card-category km--text-soft" } %>
<div class="km--card km--form-card km--form-card-narrow km--form-compact">
  <h2 class="km--form-card-title"><%= t("devise.passwords.edit.change_your_password", default: "Change your password") %></h2>
  <%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
    <%= f.error_notification %>
    <%= f.input :reset_password_token, as: :hidden %>
    <%= f.full_error :reset_password_token %>
    <div class="form-inputs">
      <%# Minimum length sits beside the label so the two password inputs stay together %>
      <div class="d-flex align-items-baseline flex-wrap gap-2 mb-2">
        <%= f.label :password, t("devise.passwords.edit.new_password", default: "New password"),
              class: "km--text-card-category km--text-soft mb-0 km--required" %>
        <% if @minimum_password_length %>
          <span class="km--text-card-content km--text-soft">
            <%= t("devise.shared.minimum_password_length", count: @minimum_password_length, default: "(%{count} characters minimum)") %>
          </span>
        <% end %>
      </div>
      <%= f.input :password, required: true, autofocus: true, label: false,
            input_html: { autocomplete: "new-password", class: "km--form-control form-control" } %>
      <%= f.input :password_confirmation,
            label: t("devise.passwords.edit.confirm_new_password", default: "Confirm new password"),
            required: true,
            input_html: { autocomplete: "new-password", class: "km--form-control form-control" }, label_html: label %>
    </div>
    <div class="form-actions d-flex justify-content-end">
      <%= f.button :submit, t("devise.passwords.edit.change_my_password", default: "Change my password"),
            class: "km--btn km--btn-primary" %>
    </div>
  <% end %>
  <div class="mt-3">
    <%= render "devise/shared/links" %>
  </div>
</div>
