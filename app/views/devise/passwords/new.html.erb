<% label = { class: "km--text-card-category km--text-soft" } %>
<div class="km--card km--form-card km--form-card-narrow km--form-compact">
  <h2 class="km--form-card-title"><%= t("devise.passwords.new.forgot_your_password", default: "Forgot your password?") %></h2>
  <%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
    <%= f.error_notification %>
    <div class="form-inputs">
      <%= f.input :email, required: true, autofocus: true,
            input_html: { autocomplete: "email", class: "km--form-control form-control" }, label_html: label %>
    </div>
    <div class="form-actions d-flex justify-content-end">
      <%= f.button :submit, t("auth.send_reset_link"),
            class: "km--btn km--btn-primary" %>
    </div>
  <% end %>
  <div class="mt-3">
    <%= render "devise/shared/links" %>
  </div>
</div>
