<% label = { class: "km--text-card-category km--text-soft" } %>
<% input = ->(autocomplete) { { autocomplete: autocomplete, class: "km--form-control form-control" } } %>
<div class="km--card km--form-card km--form-card-narrow km--form-compact">
  <h2 class="km--form-card-title"><%= t("devise.registrations.new.sign_up", default: "Sign up") %></h2>
  <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
    <%= f.error_notification %>
    <%= f.hidden_field :locale, value: I18n.locale %>
    <div class="form-inputs">
      <%= f.input :email, required: true, autofocus: true, input_html: input.("email"), label_html: label %>
      <%# Minimum length sits beside the label so the two password inputs stay together %>
      <div class="d-flex align-items-baseline flex-wrap gap-2 mb-2">
        <%= f.label :password, required: true, class: "km--text-card-category km--text-soft mb-0" %>
        <% if @minimum_password_length %>
          <span class="km--text-card-content km--text-soft">
            <%= t("devise.shared.minimum_password_length", count: @minimum_password_length, default: "(%{count} characters minimum)") %>
          </span>
        <% end %>
      </div>
      <%= f.input :password, required: true, label: false, input_html: input.("new-password") %>
      <%= f.input :password_confirmation, required: true, input_html: input.("new-password"), label_html: label %>
    </div>
    <div class="form-actions d-flex justify-content-end">
      <%= f.button :submit, t("devise.registrations.new.sign_up", default: "Sign up"), class: "km--btn km--btn-primary" %>
    </div>
  <% end %>
  <div class="mt-3">
    <%= render "devise/shared/links" %>
  </div>
</div>
