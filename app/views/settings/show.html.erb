<%# app/views/settings/show.html.erb %>
<% content_for :title, t("navigation.settings") %>
<div class="container mt-5 mb-4">
  <h2 class="mb-4"><%= t("navigation.settings") %></h2>
  <div class="row g-4">
    <%# Profile settings — role-specific %>
    <div class="col-lg-6">
      <div class="tall-card p-4">
        <h5 class="mb-3"><%= t("settings.profile") %></h5>
        <% if current_user.donor? && @donor %>
          <%= form_with model: @donor, url: settings_path, method: :patch, scope: :donor do |f| %>
            <% if @donor.errors.any? %>
              <div class="alert alert-danger">
                <ul class="mb-0">
                  <% @donor.errors.full_messages.each do |msg| %>
                    <li><%= msg %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>
            <div class="mb-3">
              <%= f.label :display_name, t("settings.display_name"), class: "form-label fw-bold" %>
              <%= f.text_field :display_name, class: "form-control" %>
            </div>
            <div class="mb-3">
              <%= f.label :donor_type, t("settings.donor_type"), class: "form-label fw-bold" %>
              <%= f.select :donor_type, [[t("settings.individual"), "individual"], [t("settings.company"), "company"]], {}, class: "form-select" %>
            </div>
            <div class="mb-3">
              <%= f.label :region, t("navigation.location"), class: "form-label fw-bold" %>
              <%= f.select :region,
                    Request::REGIONS_AND_PREFECTURES.keys.map { |r| [t("regions.#{r}"), r] },
                    { include_blank: false },
                    class: "form-select" %>
            </div>
            <div class="mb-3">
              <%= f.label :prefecture, t("prefectures.select"), class: "form-label fw-bold" %>
              <%= f.select :prefecture,
                    Request::REGIONS_AND_PREFECTURES.transform_keys { |r| t("regions.#{r}") }
                      .transform_values { |prefs| prefs.map { |p| [t("prefectures.#{p}"), p] } },
                    {},
                    class: "form-select" %>
            </div>
            <%= f.submit t("settings.save_profile"), class: "btn btn-primary" %>
          <% end %>
        <% elsif current_user.charity? && @charity %>
          <%= form_with model: @charity, url: settings_path, method: :patch, scope: :charity do |f| %>
            <% if @charity.errors.any? %>
              <div class="alert alert-danger">
                <ul class="mb-0">
                  <% @charity.errors.full_messages.each do |msg| %>
                    <li><%= msg %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>
            <div class="mb-3">
              <%= f.label :org_name, t("settings.org_name"), class: "form-label fw-bold" %>
              <%= f.text_field :org_name, class: "form-control" %>
            </div>
            <div class="mb-3">
              <%= f.label :description, t("settings.description"), class: "form-label fw-bold" %>
              <%= f.text_area :description, rows: 3, class: "form-control" %>
            </div>
            <div class="mb-3">
              <%= f.label :region, t("navigation.location"), class: "form-label fw-bold" %>
              <%= f.select :region,
                    Request::REGIONS_AND_PREFECTURES.keys.map { |r| [t("regions.#{r}"), r] },
                    { include_blank: false },
                    class: "form-select" %>
            </div>
            <div class="mb-3">
              <%= f.label :prefecture, t("navigation.prefecture"), class: "form-label fw-bold" %>
              <%= f.select :prefecture,
                  Request::REGIONS_AND_PREFECTURES.transform_keys { |r| t("regions.#{r}") }
                    .transform_values { |prefs| prefs.map { |p| [t("prefectures.#{p}"), p] } },
                  { prompt: t("prefectures.select") },
                  class: "form-select" %>
            </div>
            <div class="mb-3">
              <%= f.label :shipping_address, t("settings.shipping_address"), class: "form-label fw-bold" %>
              <%= f.text_area :shipping_address, rows: 3, class: "form-control" %>
            </div>
            <%= f.submit t("settings.save_profile"), class: "btn btn-primary" %>
          <% end %>
        <% end %>
      </div>
    </div>
    <%# Account settings — email + password, all users %>
    <div class="col-lg-6">
      <div class="tall-card p-4">
        <h5 class="mb-3"><%= t("settings.account") %></h5>
        <%= form_with model: current_user, url: settings_password_path, method: :patch, scope: :user do |f| %>
          <% if @password_errors&.any? %>
            <div class="alert alert-danger">
              <ul class="mb-0">
                <% @password_errors.full_messages.each do |msg| %>
                  <li><%= msg %></li>
                <% end %>
              </ul>
            </div>
          <% end %>
          <div class="mb-3">
            <label class="form-label fw-bold"><%= t("settings.email") %></label>
            <p class="mb-0"><%= current_user.email %></p>
          </div>
          <div class="mb-3">
            <%= f.label :current_password, t("settings.current_password"), class: "form-label fw-bold" %>
            <%= f.password_field :current_password, class: "form-control", autocomplete: "current-password" %>
          </div>
          <div class="mb-3">
            <%= f.label :password, t("settings.new_password"), class: "form-label fw-bold" %>
            <%= f.password_field :password, class: "form-control", autocomplete: "new-password", required: true, minlength: 6 %>
          </div>
          <div class="mb-3">
            <%= f.label :password_confirmation, t("settings.confirm_password"), class: "form-label fw-bold" %>
            <%= f.password_field :password_confirmation, class: "form-control", autocomplete: "new-password", required: true, minlength: 6 %>
          </div>
          <%= f.submit t("settings.change_password"), class: "btn btn-secondary" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
