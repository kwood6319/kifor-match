<%# Collapsible sections should start closed; a cached Turbo snapshot would keep them as left %>
<% content_for :head, tag.meta(name: "turbo-cache-control", content: "no-cache") %>
<% content_for :title, t("navigation.settings") %>
<% active_tab = @open_account_section.present? ? "account" : (params[:tab].presence_in(%w[location]) || "profile") %>
<% profile_record = @donor || @charity %>
<% profile_scope = @donor ? :donor : :charity %>
<div class="container mt-4 mb-5 km--settings-page">
  <div class="row">
    <%# Sidebar %>
    <div class="col-lg-3 mb-4">
      <h4 class="km--text-page-title mb-4"><%= t("settings.page_title") %></h4>
      <div class="nav flex-column nav-pills" id="settings-tabs" role="tablist" aria-orientation="vertical">
        <button class="nav-link km--nav-link<%= ' active' if active_tab == "profile" %> text-start d-flex align-items-center gap-2" data-bs-toggle="pill" data-bs-target="#tab-profile" type="button">
          <i class="fa-solid fa-user"></i> <%= t("settings.tabs.profile") %>
        </button>
        <% if profile_record %>
          <button class="nav-link km--nav-link<%= ' active' if active_tab == "location" %> text-start d-flex align-items-center gap-2" data-bs-toggle="pill" data-bs-target="#tab-location" type="button">
            <i class="fa-solid fa-location-dot"></i> <%= t("settings.tabs.location") %>
          </button>
        <% end %>
        <button class="nav-link km--nav-link<%= ' active' if active_tab == "account" %> text-start d-flex align-items-center gap-2" data-bs-toggle="pill" data-bs-target="#tab-account" type="button">
          <i class="fa-solid fa-shield-halved"></i> <%= t("settings.tabs.account") %>
        </button>
        <button class="nav-link km--nav-link text-start d-flex align-items-center gap-2" data-bs-toggle="pill" data-bs-target="#tab-notifications" type="button">
          <i class="fa-solid fa-bell"></i> <%= t("settings.tabs.notifications") %>
        </button>
        <button class="nav-link km--nav-link text-start d-flex align-items-center gap-2" data-bs-toggle="pill" data-bs-target="#tab-language" type="button">
          <i class="fa-solid fa-globe"></i> <%= t("settings.tabs.language") %>
        </button>
        <button class="nav-link km--nav-link text-start d-flex align-items-center gap-2 text-danger" data-bs-toggle="pill" data-bs-target="#tab-danger" type="button">
          <i class="fa-solid fa-triangle-exclamation"></i> <%= t("settings.tabs.danger_zone") %>
        </button>
      </div>
    </div>
    <%# Content %>
    <div class="col-lg-9">
      <%# A failed save shows its errors in a modal (long messages were unreadable as a bottom-right
          alert); the failed section is reopened underneath (@open_location_section) %>
      <% if profile_record&.errors&.any? %>
        <div class="modal fade" id="settingsErrorsModal" tabindex="-1" aria-labelledby="settingsErrorsModalLabel"
             aria-hidden="true" data-controller="auto-open-modal">
          <div class="modal-dialog">
            <div class="modal-content">
              <div class="modal-header">
                <h5 class="modal-title km--text-card-title" id="settingsErrorsModalLabel"><%= t("settings.errors_title") %></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t("buttons.close") %>"></button>
              </div>
              <div class="modal-body">
                <ul class="list-unstyled mb-0 d-flex flex-column gap-2 km--text-card-content">
                  <% profile_record.errors.full_messages.each do |msg| %>
                    <li><%= msg %></li>
                  <% end %>
                </ul>
              </div>
              <div class="modal-footer">
                <button type="button" class="km--btn km--btn-primary" data-bs-dismiss="modal"><%= t("settings.errors_ok") %></button>
              </div>
            </div>
          </div>
        </div>
      <% end %>
      <div class="tab-content">
        <%# Profile tab %>
        <%# KT TO DO: Let users set a preferred name for greetings (e.g. a charity contact's own name rather than the org name). Also decide whether display names need to be unique. %>
        <div class="tab-pane fade<%= ' show active' if active_tab == "profile" %>" id="tab-profile">
          <div class="km--card">
            <h5 class="km--text-card-title mb-1"><%= t("settings.tabs.profile") %></h5>
            <% if profile_record %>
              <p class="km--text-card-content km--text-soft mb-4"><%= t("settings.profile_description") %></p>
            <% end %>
            <% if current_user.donor? && @donor %>
              <%= form_with model: @donor, url: settings_path, method: :patch, scope: :donor do |f| %>
                <div class="mb-3">
                  <%= f.label :display_name, t("settings.display_name"), class: "km--text-card-category km--text-soft d-block mb-2" %>
                  <%= f.text_field :display_name, class: "km--form-control form-control" %>
                </div>
                <div class="d-flex justify-content-end">
                  <button type="submit" class="km--btn km--btn-primary">
                    <%= t("buttons.save") %>
                  </button>
                </div>
              <% end %>
            <% elsif current_user.charity? && @charity %>
              <%= form_with model: @charity, url: settings_path, method: :patch, scope: :charity do |f| %>
                <div class="mb-3">
                  <%= f.label :org_name, t("settings.org_name"), class: "km--text-card-category km--text-soft d-block mb-2" %>
                  <%= f.text_field :org_name, class: "km--form-control form-control" %>
                </div>
                <div class="mb-3">
                  <%= f.label :description, t("settings.description"), class: "km--text-card-category km--text-soft d-block mb-2" %>
                  <%= f.text_area :description, rows: 3, class: "km--form-control form-control km--no-resize" %>
                </div>
                <div class="d-flex justify-content-end">
                  <button type="submit" class="km--btn km--btn-primary">
                    <%= t("buttons.save") %>
                  </button>
                </div>
              <% end %>
            <% else %>
              <%# KT TO DO: Add settings here %>
              <p class="km--text-card-content km--text-soft mb-0"><%= t("settings.no_profile_settings") %></p>
              <% if current_user.admin? %>
                <%# TO DO: Admin identifiers (e.g. display name / staff ID shown on approvals) %>
                <div class="km--settings-section mt-4">
                  <p class="km--text-card-content km--text-soft mb-0">
                    <i class="fa-solid fa-hourglass-half me-1"></i><%= t("settings.admin_identifiers_coming_soon") %>
                  </p>
                </div>
              <% end %>
            <% end %>
          </div>
        </div>
        <%# Location tab: region/prefecture for donors, the full address (which includes them) for charities %>
        <% if profile_record %>
          <div class="tab-pane fade<%= ' show active' if active_tab == "location" %>" id="tab-location">
            <div class="km--card">
              <h5 class="km--text-card-title mb-1"><%= t("settings.tabs.location") %></h5>
              <p class="km--text-card-content km--text-soft mb-4"><%= t("settings.location_description") %></p>
              <% if @charity %>
                <%# Address and donation preferences save separately, like the Email & Password tab.
                    Both start collapsed; only a failed save (re-rendered with errors) reopens its section. %>
                <% open_section = @open_location_section %>
                <div class="km--settings-section">
                  <button class="km--settings-section-toggle<%= ' collapsed' unless open_section == "address" %>" type="button"
                    data-bs-toggle="collapse" data-bs-target="#settings-address"
                    aria-expanded="<%= open_section == "address" %>" aria-controls="settings-address">
                    <span><i class="fa-solid fa-location-dot me-2"></i><%= t("settings.address_section") %></span>
                    <i class="fa-solid fa-chevron-down km--settings-section-chevron"></i>
                  </button>
                  <div class="collapse<%= ' show' if open_section == "address" %>" id="settings-address">
                    <%= form_with model: @charity, url: settings_path, method: :patch, scope: :charity, class: "pt-3", id: "settings-address-form", html: { novalidate: true } do |f| %>
                      <%= hidden_field_tag :tab, "location", id: nil %>
                      <%= hidden_field_tag :section, "address", id: nil %>
                      <%= f.fields_for :address, (@charity.address || @charity.build_address) do |address_form| %>
                        <%= render "shared/address_fields", f: address_form %>
                      <% end %>
                      <div class="d-flex justify-content-end">
                        <%# With a parcel already on its way, confirm first (#confirmAddressModal submits this form) %>
                        <% if @has_shipped_offers %>
                          <button type="button" class="km--btn km--btn-primary" data-bs-toggle="modal" data-bs-target="#confirmAddressModal">
                            <%= t("buttons.save") %>
                          </button>
                        <% else %>
                          <button type="submit" class="km--btn km--btn-primary"><%= t("buttons.save") %></button>
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                </div>
                <div class="km--settings-section">
                  <button class="km--settings-section-toggle<%= ' collapsed' unless open_section == "donation_preferences" %>" type="button"
                    data-bs-toggle="collapse" data-bs-target="#settings-donation-preferences"
                    aria-expanded="<%= open_section == "donation_preferences" %>" aria-controls="settings-donation-preferences">
                    <span><i class="fa-solid fa-box me-2"></i><%= t("settings.donation_preferences") %></span>
                    <i class="fa-solid fa-chevron-down km--settings-section-chevron"></i>
                  </button>
                  <div class="collapse<%= ' show' if open_section == "donation_preferences" %>" id="settings-donation-preferences">
                    <%= form_with model: @charity, url: settings_path, method: :patch, scope: :charity, class: "pt-3", html: { novalidate: true } do |f| %>
                      <%= hidden_field_tag :tab, "location", id: nil %>
                      <%= hidden_field_tag :section, "donation_preferences", id: nil %>
                      <%= render "charities/donation_preferences_fields", f: f %>
                      <div class="d-flex justify-content-end">
                        <button type="submit" class="km--btn km--btn-primary"><%= t("buttons.save") %></button>
                      </div>
                    <% end %>
                  </div>
                </div>
              <% else %>
                <%= form_with model: profile_record, url: settings_path, method: :patch, scope: profile_scope, html: { novalidate: true } do |f| %>
                  <%= hidden_field_tag :tab, "location", id: nil %>
                  <% prefecture_options = prefecture_options_by_region %>
                  <div class="row" data-controller="prefecture-filter" data-prefecture-filter-prefectures-value="<%= prefecture_options.to_json %>">
                    <div class="col-md-6 mb-3">
                      <%= f.label :region, t("navigation.region"), class: "km--text-card-category km--text-soft d-block mb-2" %>
                      <%= f.select :region,
                        Request::REGIONS_AND_PREFECTURES.keys.map { |r| [t("regions.#{r}"), r] },
                        { include_blank: false }, class: "km--form-control form-select",
                        data: { prefecture_filter_target: "region", action: "prefecture-filter#filter" } %>
                    </div>
                    <div class="col-md-6 mb-3">
                      <%= f.label :prefecture, t("navigation.prefecture"), class: "km--text-card-category km--text-soft d-block mb-2" %>
                      <%= f.select :prefecture, prefecture_options.fetch(profile_record.region, []),
                        { prompt: t("prefectures.select") }, class: "km--form-control form-select",
                        data: { prefecture_filter_target: "prefecture" } %>
                    </div>
                  </div>
                  <div class="d-flex justify-content-end">
                    <button type="submit" class="km--btn km--btn-primary"><%= t("buttons.save") %></button>
                  </div>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>
        <%# Account tab: email and password save separately; only the password needs the current password %>
        <div class="tab-pane fade<%= ' show active' if active_tab == "account" %>" id="tab-account">
          <div class="km--card">
            <h5 class="km--text-card-title mb-1"><%= t("settings.tabs.account") %></h5>
            <p class="km--text-card-content km--text-soft mb-4"><%= t("settings.account_description") %></p>
            <% if @account_errors&.any? %>
              <div class="alert alert-danger km--toast">
                <ul class="list-unstyled mb-0 d-flex flex-column gap-1">
                  <% @account_errors.full_messages.each { |msg| %>
                  <li><%= msg %></li>
                  <% } %>
                </ul>
              </div>
            <% end %>
            <%# Email section %>
            <div class="km--settings-section">
              <button class="km--settings-section-toggle<%= ' collapsed' unless @open_account_section == :email %>" type="button"
                data-bs-toggle="collapse" data-bs-target="#settings-email"
                aria-expanded="<%= @open_account_section == :email %>" aria-controls="settings-email">
                <span><i class="fa-solid fa-envelope me-2"></i><%= t("settings.email") %></span>
                <i class="fa-solid fa-chevron-down km--settings-section-chevron"></i>
              </button>
              <div class="collapse<%= ' show' if @open_account_section == :email %>" id="settings-email">
                <%= form_with model: current_user, url: settings_email_path, method: :patch, scope: :user, class: "pt-3" do |f| %>
                  <div class="mb-3">
                    <%= f.label :current_password, t("settings.current_password"), class: "km--text-card-category km--text-soft d-block mb-2", for: "email_current_password" %>
                    <%= f.password_field :current_password, id: "email_current_password", class: "km--form-control form-control", autocomplete: "current-password", required: true %>
                  </div>
                  <div class="mb-3">
                    <%= f.label :email, t("settings.email"), class: "km--text-card-category km--text-soft d-block mb-2" %>
                    <%= f.email_field :email, class: "km--form-control form-control", autocomplete: "email", required: true %>
                  </div>
                  <div class="d-flex justify-content-end">
                    <button type="submit" class="km--btn km--btn-primary"><%= t("buttons.save") %></button>
                  </div>
                <% end %>
              </div>
            </div>
            <%# Password section %>
            <div class="km--settings-section">
              <button class="km--settings-section-toggle<%= ' collapsed' unless @open_account_section == :password %>" type="button"
                data-bs-toggle="collapse" data-bs-target="#settings-password"
                aria-expanded="<%= @open_account_section == :password %>" aria-controls="settings-password">
                <span><i class="fa-solid fa-key me-2"></i><%= t("settings.change_password") %></span>
                <i class="fa-solid fa-chevron-down km--settings-section-chevron"></i>
              </button>
              <div class="collapse<%= ' show' if @open_account_section == :password %>" id="settings-password">
                <%= form_with model: current_user, url: settings_password_path, method: :patch, scope: :user, class: "pt-3" do |f| %>
                  <div class="mb-3">
                    <%= f.label :current_password, t("settings.current_password"), class: "km--text-card-category km--text-soft d-block mb-2" %>
                    <%= f.password_field :current_password, class: "km--form-control form-control", autocomplete: "current-password", required: true %>
                  </div>
                  <div class="mb-3">
                    <%= f.label :password, t("settings.new_password"), class: "km--text-card-category km--text-soft d-block mb-2" %>
                    <%= f.password_field :password, class: "km--form-control form-control", autocomplete: "new-password", minlength: 6, required: true %>
                  </div>
                  <div class="mb-3">
                    <%= f.label :password_confirmation, t("settings.confirm_password"), class: "km--text-card-category km--text-soft d-block mb-2" %>
                    <%= f.password_field :password_confirmation, class: "km--form-control form-control", autocomplete: "new-password", minlength: 6, required: true %>
                  </div>
                  <div class="d-flex justify-content-end">
                    <button type="submit" class="km--btn km--btn-primary"><%= t("buttons.save") %></button>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </div>
        <%# Notifications tab — placeholder %>
        <div class="tab-pane fade" id="tab-notifications">
          <div class="km--card text-center py-5">
            <i class="fa-solid fa-bell fa-2x km--text-soft mb-3"></i>
            <h5 class="km--text-card-title"><%= t("settings.notifications_coming_soon") %></h5>
            <p class="km--text-card-content km--text-soft mb-0"><%= t("settings.notifications_coming_soon_desc") %></p>
          </div>
        </div>
        <%# Language tab %>
        <div class="tab-pane fade" id="tab-language">
          <div class="km--card">
            <h5 class="km--text-card-title mb-1"><%= t("settings.tabs.language") %></h5>
            <p class="km--text-card-content km--text-soft mb-4"><%= t("settings.language_description") %></p>
            <%= form_with model: current_user, url: settings_locale_path, method: :patch, scope: :user do |f| %>
              <div class="km--settings-options mb-3">
                <% [["en", t("settings.english")], ["ja", t("settings.japanese")]].each do |value, label| %>
                  <label class="km--settings-option">
                    <%= f.radio_button :locale, value, class: "form-check-input mt-0" %>
                    <span class="km--text-card-content"><%= label %></span>
                  </label>
                <% end %>
              </div>
              <div class="d-flex justify-content-end">
                <button type="submit" class="km--btn km--btn-primary">
                  <%= t("buttons.save") %>
                </button>
              </div>
            <% end %>
          </div>
        </div>
        <%# Danger zone — deliberately styled apart from the tan .km--card treatment above %>
        <div class="tab-pane fade" id="tab-danger">
          <div class="km--card km--card-danger">
            <h5 class="km--text-card-title text-danger mb-1">
              <i class="fa-solid fa-triangle-exclamation me-1"></i><%= t("settings.tabs.danger_zone") %>
            </h5>
            <p class="km--text-card-content km--text-soft mb-4"><%= t("settings.danger_zone_description") %></p>
            <div class="d-flex justify-content-end">
              <button type="button" class="km--btn km--btn-danger" data-bs-toggle="modal" data-bs-target="#deactivateModal">
                <%= t("settings.deactivate_account") %>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<%# Deactivate confirmation modal %>
<% if @charity && @has_shipped_offers %>
  <%# Shown instead of saving straight away when a donor may already have the old address %>
  <div class="modal fade" id="confirmAddressModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title km--text-card-title"><%= t("settings.confirm_address_title") %></h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t("buttons.close") %>"></button>
        </div>
        <div class="modal-body">
          <p class="mb-0"><%= t("settings.shipping_address_warning") %></p>
        </div>
        <%# Only the save button: the X in the header backs out without saving %>
        <div class="modal-footer">
          <button type="submit" form="settings-address-form" class="km--btn km--btn-primary"><%= t("settings.confirm_address_save") %></button>
        </div>
      </div>
    </div>
  </div>
<% end %>
<div class="modal fade" id="deactivateModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title km--text-card-title"><%= t("settings.deactivate_modal_title") %></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <p><%= t("settings.deactivate_modal_body") %></p>
      </div>
      <div class="modal-footer">
        <button type="button" class="km--btn km--btn-outline" data-bs-dismiss="modal"><%= t("buttons.cancel") %></button>
        <%= button_to t("settings.deactivate_account"), settings_deactivate_path, method: :patch, class: "km--btn km--btn-danger" %>
      </div>
    </div>
  </div>
</div>
