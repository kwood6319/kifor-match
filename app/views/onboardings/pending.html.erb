  <i class="fa-solid fa-hourglass-half fa-2x km--text-soft mb-3"></i>
  <h2 class="km--form-card-title"><%= t("onboarding.pending_title") %></h2>
  <p class="km--text-card-content km--text-soft"><%= t("onboarding.pending_body") %></p>
  <p class="km--text-card-content mb-0">
    <%= link_to t("navigation.settings"), settings_path %> ·
