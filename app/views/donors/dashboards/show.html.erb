<% content_for :main_class, "d-flex flex-column" %>
<div class="container mt-3 mb-4">
  <h3 class="km--text-page-title mb-0">
    <%= t("messages.welcome_back") %>, <%= current_donor.display_name %><%= "様" if I18n.locale == :ja %>!
    <%= t("messages.top_categories") %>:
  </h3>
</div>
<div class="container-fluid mt-4 km--fill-page">
  <div class="row mb-4 flex-grow-1">
    <!-- Left grid: category cards -->
    <div class="col-md-8">
      <div class="km--card-grid km--card-grid-fill">
        <% @top_categories.each do |key| %>
          <% category_data = CategoryList::CATEGORIES[key] %>
          <% next unless category_data %>
          <%= link_to requests_path(category: [key]), class: "text-decoration-none km--text-dark" do %>
            <div class="km--card text-center h-100">
              <div class="d-flex flex-column justify-content-center align-items-center flex-grow-1 py-4">
                <% icon = category_data[:icons].first %>
                <% if icon %>
                  <i class="fa-solid <%= icon %> fa-3x mb-2"></i>
                <% end %>
                <p class="km--text-card-title mb-0"><%= CategoryList.label_for(key) %></p>
              </div>
            </div>
          <% end %>
        <% end %>
        <%= link_to requests_path, class: "text-decoration-none km--text-dark" do %>
          <div class="km--card text-center h-100">
            <div class="d-flex flex-column justify-content-center align-items-center flex-grow-1 py-4">
              <i class="fa-solid fa-ellipsis fa-3x mb-2"></i>
              <p class="km--text-card-title mb-0"><%= t("categories.all") %></p>
            </div>
          </div>
        <% end %>
      </div>
    </div>
    <!-- Right column: offer tracker, tabbed by status like the charity dashboard -->
    <div class="col-md-4 position-relative km--fill-column">
      <%# Tabs sit above the card so they stay reachable while the list scrolls %>
      <%# TO DO (mobile support): tab names are cut off with "…" on narrow screens (~800px and below) %>
      <div class="km--fill-column-card d-flex flex-column">
        <ul class="nav nav-tabs km--nav-tabs mb-2" id="donor-tracker-tabs" role="tablist">
          <li class="nav-item" role="presentation">
            <button class="nav-link km--nav-link active" data-bs-toggle="pill" data-bs-target="#tracker-attention" type="button">
              <i class="fa-solid fa-triangle-exclamation"></i><%= t("dashboard.needs_your_attention") %>
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link km--nav-link" data-bs-toggle="pill" data-bs-target="#tracker-submitted" type="button">
              <i class="fa-solid fa-inbox"></i><%= t("dashboard.offers_submitted") %>
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link km--nav-link" data-bs-toggle="pill" data-bs-target="#tracker-shipped" type="button">
              <i class="fa-solid fa-truck"></i><%= t("dashboard.offers_on_their_way") %>
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link km--nav-link" data-bs-toggle="pill" data-bs-target="#tracker-received" type="button">
              <i class="fa-solid fa-box-open"></i><%= t("dashboard.offers_received") %>
            </button>
          </li>
        </ul>
        <div class="km--card km--fill-column-scroll">
        <div class="tab-content">
          <div class="tab-pane fade show active" id="tracker-attention">
            <%= render "donors/dashboards/offer_tracker_list", offers: @attention_offers %>
          </div>
          <div class="tab-pane fade" id="tracker-submitted">
            <%= render "donors/dashboards/offer_tracker_list", offers: @submitted_offers %>
          </div>
          <div class="tab-pane fade" id="tracker-shipped">
            <%= render "donors/dashboards/offer_tracker_list", offers: @shipped_offers %>
          </div>
          <div class="tab-pane fade" id="tracker-received">
            <%= render "donors/dashboards/offer_tracker_list", offers: @received_offers %>
          </div>
        </div>
        </div>
      </div>
    </div>
  </div>
</div>
<%# Toast notification %>
<div class="toast-container position-fixed top-0 end-0 p-3 km--toast-stack">
  <% @notifications.each do |notification| %>
    <%= turbo_frame_tag "notification_#{notification.id}" do %>
      <div class="toast show mb-2" role="alert" id="notification_<%= notification.id %>">
        <div class="toast-header">
          <strong class="me-auto"><%= t("notifications.title") %></strong>
          <%= button_to "", dismiss_notification_path(notification), method: :patch, class: "btn-close",
                "aria-label": t("buttons.close"),
                form: { data: { turbo_frame: "notification_#{notification.id}" } } %>
        </div>
        <div class="toast-body">
          <%= link_to notification.message, notification.link_path, class: "text-decoration-none", data: { turbo_frame: "_top" } %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
