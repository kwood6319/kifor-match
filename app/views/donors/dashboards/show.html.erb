<div class="container mt-3 mb-4">
  <h3>
    <%= t("messages.welcome_back") %>, <%= current_user.email.gsub(/@.*$/, "").capitalize %><%= "様" if I18n.locale == :ja %>!
    <%= t("messages.top_categories") %>:
  </h3>
</div>
<div class="container-fluid mt-4">
  <div class="row mb-4">
    <!-- Left grid: category cards -->
    <div class="col-md-8">
      <div class="km--card-grid">
        <% @top_categories.each do |key| %>
          <% category_data = CategoryList::CATEGORIES[key] %>
          <% next unless category_data %>
          <%= link_to requests_path(category: [key]), class: "text-decoration-none km--text-dark" do %>
            <div class="km--card text-center">
              <div class="d-flex flex-column justify-content-center align-items-center flex-grow-1 py-4">
                <% icon = category_data[:icons].first %>
                <% if icon %>
                  <i class="fa-solid <%= icon %> fa-3x mb-2"></i>
                <% end %>
                <p class="km--text-card-title mb-0"><%= CategoryList.label_for(key) %></p>
              </div>
            </div>
          <% end %>
        <% end %>
        <%= link_to requests_path, class: "text-decoration-none km--text-dark" do %>
          <div class="km--card text-center">
            <div class="d-flex flex-column justify-content-center align-items-center flex-grow-1 py-4">
              <i class="fa-solid fa-ellipsis fa-3x mb-2"></i>
              <p class="km--text-card-title mb-0"><%= t("categories.all") %></p>
            </div>
          </div>
        <% end %>
      </div>
    </div>
    <!-- Right column: pending offers -->
    <div class="col-md-4 d-flex">
      <div class="km--card w-100" style="max-height: 80vh; overflow-y: auto;">
        <h5 class="km--text-card-title mb-3"><%= t("dashboard.pending") %>:</h5>
        <% if @pending_offers.any? %>
          <div class="km--card-list">
            <% @pending_offers.each do |offer| %>
              <%= link_to request_path(offer.request), class: "text-decoration-none km--text-dark" do %>
                <div class="km--card-list-item">
                  <div class="d-flex justify-content-between align-items-start">
                    <strong class="km--text-card-subtitle"><%= offer.request.title %></strong>
                    <div class="text-nowrap">
                      <span class="badge rounded-pill pill-urgent km--text-pill km--text-light"><%= time_ago_badge(offer.updated_at) %></span>
                      <span class="ms-1 km--text-soft km--text-card-content">x<%= offer.quantity_offered %></span>
                    </div>
                  </div>
                  <p class="km--text-card-content mb-1">
                    <i class="fa-solid fa-location-dot mb-2"></i>
                    <%= t("regions.#{offer.request.charity.region}") %> - <%= t("prefectures.#{offer.request.charity.prefecture}") %>
                  </p>
                  <p class="km--text-card-content mb-1">
                    <strong><%= t("dashboard.condition") %>:</strong> <%= t("conditions.#{offer.condition}") %>
                  </p>
                  <% if offer.can_ship_by.present? %>
                    <p class="km--text-card-content mb-1">
                      <strong><%= t("dashboard.can_ship_by") %>:</strong> <%= offer.can_ship_by.strftime("%b %-d") %>
                    </p>
                  <% end %>
                  <p class="km--text-card-content mb-0">
                    <strong><%= t("dashboard.alerts") %>:</strong> <%= offer.alert_message %>
                  </p>
                </div>
                <br>
              <% end %>
            <% end %>
          </div>
        <% else %>
          <p class="km--text-soft mb-0"><%= t("dashboard.no_pending_offers") %></p>
        <% end %>
      </div>
    </div>
  </div>
</div>
<%# Toast notification %>
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1080">
  <% @notifications.each do |notification| %>
    <%= turbo_frame_tag "notification_#{notification.id}" do %>
      <div class="toast show mb-2" role="alert" id="notification_<%= notification.id %>">
        <div class="toast-header">
          <strong class="me-auto"><%= t("notifications.title") %></strong>
          <%= button_to "", dismiss_notification_path(notification), method: :patch, class: "btn-close",
                "aria-label": t("buttons.close"),
                form: { data: { turbo_frame: "notification_#{notification.id}" } } %>
        </div>
        <div class="toast-body">
          <%= link_to notification.message, notification.link_path, class: "text-decoration-none", data: { turbo_frame: "_top" } %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
