<% if offers.any? %>
  <div class="km--card-list">
    <% offers.each do |offer| %>
      <%# Card is a div with a stretched link (not a link wrapper) so the dismiss button can sit inside it %>
      <div class="km--text-dark km--card-list-item d-flex flex-column gap-1 position-relative">
        <div class="d-flex justify-content-between align-items-start gap-2">
          <%= link_to request_path(offer.request), class: "text-decoration-none km--text-dark stretched-link" do %>
            <strong class="km--text-card-subtitle"><%= title_with_quantity(offer.request.title, offer.quantity_offered) %></strong>
          <% end %>
          <div class="d-flex align-items-center gap-2 flex-shrink-0">
            <span class="badge rounded-pill pill-urgent km--text-pill km--text-light text-nowrap"><%= time_ago_badge(offer.updated_at) %></span>
            <% if policy(offer).archive? %>
              <%# Sits above the stretched link so clicking it dismisses instead of opening the request %>
              <%= button_to "", archive_offer_path(offer), method: :patch, class: "btn-close",
                    form_class: "position-relative z-2 d-flex",
                    title: t("buttons.dismiss"), "aria-label": t("buttons.dismiss") %>
            <% end %>
          </div>
        </div>
        <p class="km--text-card-content mb-0">
          <i class="fa-solid fa-location-dot fa-fw me-1"></i><%= charity_location(offer.request.charity) %>
        </p>
        <p class="km--text-card-content mb-0" title="<%= t("dashboard.condition") %>">
          <i class="fa-solid fa-box-open fa-fw me-1"></i><span class="badge text-bg-info"><%= t("conditions.#{offer.condition}") %></span>
        </p>
        <% if (ship_date = offer_ship_date(offer)) %>
          <p class="km--text-card-content mb-0" title="<%= ship_date[:label] %>">
            <i class="fa-solid fa-truck fa-fw me-1"></i><%= l(ship_date[:date], format: :short) %>
          </p>
        <% end %>
        <p class="km--text-card-content mb-0" title="<%= t("dashboard.alerts") %>">
          <i class="fa-solid fa-message fa-fw me-1"></i><%= offer.alert_message %>
        </p>
      </div>
    <% end %>
  </div>
<% else %>
  <p class="km--text-soft mb-0"><%= t("dashboard.no_pending_offers") %></p>
<% end %>
